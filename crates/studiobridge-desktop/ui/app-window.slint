component SaveProfileGlyph inherits Rectangle {
    in property <color> colour: Theme.quiet;
    background: transparent;
    Rectangle { x: 4px; y: 5px; width: 9px; height: 10px; background: transparent; border-width: 1px; border-color: root.colour; }
    Rectangle { x: 6px; y: 6px; width: 5px; height: 3px; background: root.colour; }
    Rectangle { x: 6px; y: 11px; width: 5px; height: 3px; background: transparent; border-width: 1px; border-color: root.colour; }
}

component DuplicateProfileGlyph inherits Rectangle {
    in property <color> colour: Theme.quiet;
    background: transparent;
    Rectangle { x: 6px; y: 4px; width: 7px; height: 9px; background: transparent; border-width: 1px; border-color: root.colour; }
    Rectangle { x: 3px; y: 7px; width: 7px; height: 9px; background: #3a393e; border-width: 1px; border-color: root.colour; }
}

component DeleteProfileGlyph inherits Rectangle {
    in property <color> colour: Theme.quiet;
    background: transparent;
    Rectangle { x: 4px; y: 6px; width: 9px; height: 1px; background: root.colour; }
    Rectangle { x: 6px; y: 4px; width: 5px; height: 2px; background: transparent; border-width: 1px; border-color: root.colour; }
    Rectangle { x: 5px; y: 8px; width: 7px; height: 8px; background: transparent; border-width: 1px; border-color: root.colour; }
}

component MixerProfileRow inherits Rectangle {
    in property <ProfileModel> profile;
    callback selected;
    callback saved;
    callback duplicated;
    callback deleted;
    height: 22px;
    background: root.profile.active ? #3a393e : transparent;
    property <bool> controls-visible: name-area.has-hover || save-area.has-hover
        || duplicate-area.has-hover || delete-area.has-hover
        || save-focus.has-focus || duplicate-focus.has-focus || delete-focus.has-focus;

    Text {
        x: 20px;
        width: parent.width - 72px;
        text: root.profile.name;
        color: root.profile.active ? Theme.text : Theme.quiet;
        font-size: 11px;
        font-weight: root.profile.active ? 700 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    name-focus := FocusScope {
        width: parent.width - 52px; height: parent.height;
        accessible-role: button;
        accessible-label: "Load mixer profile " + root.profile.name;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.selected();
                return accept;
            }
            return reject;
        }
        name-area := TouchArea { clicked => { name-focus.focus(); root.selected(); } }
    }

    save-focus := FocusScope {
        x: parent.width - 50px; width: 16px; height: parent.height;
        accessible-role: button;
        accessible-label: "Save mixer profile " + root.profile.name;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.saved(); return accept; } return reject; }
        SaveProfileGlyph { width: parent.width; height: parent.height; visible: root.controls-visible; colour: save-area.has-hover || save-focus.has-focus ? Theme.text : Theme.quiet; }
        save-area := TouchArea { clicked => { save-focus.focus(); root.saved(); } }
    }

    duplicate-focus := FocusScope {
        x: parent.width - 34px; width: 16px; height: parent.height;
        accessible-role: button;
        accessible-label: "Duplicate mixer profile " + root.profile.name;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.duplicated(); return accept; } return reject; }
        DuplicateProfileGlyph { width: parent.width; height: parent.height; visible: root.controls-visible; colour: duplicate-area.has-hover || duplicate-focus.has-focus ? Theme.text : Theme.quiet; }
        duplicate-area := TouchArea { clicked => { duplicate-focus.focus(); root.duplicated(); } }
    }

    delete-focus := FocusScope {
        x: parent.width - 18px; width: 16px; height: parent.height;
        accessible-role: button;
        accessible-label: "Delete mixer profile " + root.profile.name;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.deleted(); return accept; } return reject; }
        DeleteProfileGlyph { width: parent.width; height: parent.height; visible: root.controls-visible; colour: delete-area.has-hover || delete-focus.has-focus ? Theme.text : Theme.quiet; }
        delete-area := TouchArea { clicked => { delete-focus.focus(); root.deleted(); } }
    }
}

component ProfileRail inherits Rectangle {
    in property <bool> connected;
    in property <bool> hardware-safe;
    in property <bool> link-active;
    in property <[ProfileModel]> mixer-profiles;
    in property <bool> studio-profiles-expanded: true;
    in property <bool> mixer-profiles-expanded: true;
    callback create-profile;
    callback save-profile(string);
    callback duplicate-profile(string);
    callback select-profile(string);
    callback delete-profile(string);
    callback expansion-changed(bool, bool);
    width: 285px;
    background: #242427;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding-top: 10px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 8px;

        Text { text: "PROFILES"; color: Theme.text; font-size: 14px; font-weight: 800; }
        Rectangle { height: 1px; background: Theme.border; }

        Rectangle {
            height: root.studio-profiles-expanded ? 102px : 24px;
            background: transparent;
            VerticalLayout {
                spacing: 3px;
                Rectangle {
                    height: 24px;
                    Text { x: 2px; width: parent.width - 34px; text: (root.studio-profiles-expanded ? "⌄  " : "›  ") + "BEACN Studio 1"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                    Text { x: parent.width - 18px; text: "+"; color: #66666b; font-size: 18px; vertical-alignment: center; }
                    studio-profiles-focus := FocusScope {
                        width: parent.width - 32px; height: parent.height;
                        accessible-role: button;
                        accessible-label: (root.studio-profiles-expanded ? "Collapse" : "Expand") + " BEACN Studio profiles";
                        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.expansion-changed(!root.studio-profiles-expanded, root.mixer-profiles-expanded); return accept; } return reject; }
                        TouchArea { clicked => { studio-profiles-focus.focus(); root.expansion-changed(!root.studio-profiles-expanded, root.mixer-profiles-expanded); } }
                    }
                }
                if root.studio-profiles-expanded: Text { text: "     Default Profile (1)"; color: Theme.quiet; font-size: 11px; }
                if root.studio-profiles-expanded: Text { text: "     Default Profile"; color: Theme.quiet; font-size: 11px; }
                if root.studio-profiles-expanded: Rectangle {
                    height: 24px;
                    background: #3a393e;
                    Text { text: "     On Device"; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                spacing: 3px;
                Rectangle {
                    height: 24px;
                    Text { x: 2px; width: parent.width - 34px; text: (root.mixer-profiles-expanded ? "⌄  " : "›  ") + "Mixer Profiles"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                    Text { x: parent.width - 18px; text: "+"; color: Theme.text; font-size: 18px; vertical-alignment: center; }
                    mixer-profiles-focus := FocusScope {
                        width: parent.width - 32px; height: parent.height;
                        accessible-role: button;
                        accessible-label: (root.mixer-profiles-expanded ? "Collapse" : "Expand") + " mixer profiles";
                        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.expansion-changed(root.studio-profiles-expanded, !root.mixer-profiles-expanded); return accept; } return reject; }
                        TouchArea { clicked => { mixer-profiles-focus.focus(); root.expansion-changed(root.studio-profiles-expanded, !root.mixer-profiles-expanded); } }
                    }
                    create-profile-focus := FocusScope {
                        x: parent.width - 32px; width: 32px; height: parent.height;
                        accessible-role: button;
                        accessible-label: "Create mixer profile";
                        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.create-profile(); return accept; } return reject; }
                        TouchArea { clicked => { create-profile-focus.focus(); root.create-profile(); } }
                    }
                }
                if root.mixer-profiles-expanded: VerticalLayout {
                    spacing: 3px;
                    for profile in root.mixer-profiles: MixerProfileRow {
                        profile: profile;
                        selected => { root.select-profile(profile.name); }
                        saved => { root.save-profile(profile.name); }
                        duplicated => { root.duplicate-profile(profile.name); }
                        deleted => { root.delete-profile(profile.name); }
                    }
                    if root.mixer-profiles.length == 0: Text { text: "     New Profile"; color: Theme.quiet; font-size: 11px; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Text { text: "App V0.1.0"; color: Theme.quiet; font-size: 9px; horizontal-alignment: right; }
    }
}

component AddSourceRow inherits Rectangle {
    in property <string> label;
    in property <bool> available: true;
    callback selected(string);
    height: 18px;
    background: root.available && touch.has-hover ? #3a393e : transparent;
    add-source-row-focus := FocusScope {
        width: parent.width; height: parent.height;
        enabled: root.available;
        accessible-role: button;
        accessible-label: "Add " + root.label;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.selected(root.label);
                return accept;
            }
            return reject;
        }
        Text {
            x: 20px; width: parent.width - 23px;
            text: root.label;
            color: root.available ? Theme.text : #6d6d71;
            font-size: 10px; font-weight: root.available ? 800 : 400;
            vertical-alignment: center;
        }
        touch := TouchArea {
            enabled: root.available;
            clicked => { add-source-row-focus.focus(); root.selected(root.label); }
        }
    }
}

export component MainWindow inherits Window {
    title: "StudioBridge";
    icon: @image-url("../assets/studiobridge.svg");
    // BEACN's measured outer default is 1404x810 on Windows. Native window
    // decoration adds 2px horizontally and 32px vertically to this client.
    preferred-width: 1402px;
    preferred-height: 778px;
    min-width: 1120px;
    min-height: 700px;
    background: Theme.background;
    init => { root.width = 1402px; root.height = 778px; }

    in property <[SourceModel]> sources;
    in property <[RouteModel]> routes;
    in property <[ApplicationModel]> linux-applications;
    in property <[LinkApplicationModel]> link-applications;
    in property <[TargetModel]> targets;
    in property <[EqBandModel]> eq-bands;
    in property <[ProfileModel]> mixer-profiles;
    in property <[HotkeyModel]> hotkeys;
    property <float> microphone-meter: root.sources.length > 0 ? root.sources[0].meter : 0;
    in property <[string]> mixer-channel-names;
    in property <[string]> link-channel-names;
    in property <[string]> default-input-names;
    in property <[string]> default-input-ids;
    in property <[string]> default-output-names;
    in property <[string]> default-output-ids;
    in property <string> source-name-key: "";
    in property <int> default-input-index: -1;
    in property <int> default-output-index: -1;
    in-out property <int> active-page: 0;
    in-out property <int> mixer-context-page: 0;
    in property <bool> daemon-connected: false;
    in property <bool> hardware-safe: true;
    in property <bool> link-active: false;
    in property <int> dsp-gate-count: 0;
    in-out property <string> dsp-selected-module: "noise_suppression";
    in property <string> dsp-active-module: "";
    in property <int> dsp-lease-seconds: 0;
    in-out property <bool> arm-confirm-pending: false;
    in-out property <bool> dsp-advanced: false;
    in-out property <bool> dsp-enabled: true;
    in-out property <bool> noise-snapshot: false;
    in-out property <bool> eq-guide: false;
    in property <bool> eq-advanced: false;
    in property <int> eq-selected-band: 0;
    in property <string> eq-band-type: "bell";
    in property <float> eq-frequency-hz: 1000;
    in property <float> eq-gain-db: 0;
    in property <float> eq-q: 1;
    in property <bool> eq-band-enabled: true;
    in property <bool> eq-can-add-band: false;
    in property <int> enhancement-bass-preset: 1;
    in property <float> enhancement-bass-amount: 0;
    in property <float> enhancement-de-esser-amount: 0;
    in property <float> enhancement-exciter-amount: 0;
    in property <float> enhancement-exciter-frequency: 0;
    in property <bool> enhancement-bass-enabled: false;
    in property <bool> enhancement-de-esser-enabled: false;
    in property <bool> enhancement-exciter-enabled: false;
    in property <string> dsp-editor-title: "HEADPHONE EQUALIZER";
    in property <string> dsp-label-a: "Bass dB";
    in property <string> dsp-label-b: "Mids dB";
    in property <string> dsp-label-c: "Treble dB";
    in property <string> dsp-label-d: "";
    in-out property <float> dsp-value-a: 0;
    in-out property <float> dsp-value-b: 0;
    in-out property <float> dsp-value-c: 0;
    in-out property <float> dsp-value-d: 0;
    in property <float> dsp-min-a: -12;
    in property <float> dsp-max-a: 12;
    in property <float> dsp-min-b: -12;
    in property <float> dsp-max-b: 12;
    in property <float> dsp-min-c: -12;
    in property <float> dsp-max-c: 12;
    in property <float> dsp-min-d: 0;
    in property <float> dsp-max-d: 1;
    in property <string> status-text: "Connecting to StudioBridge daemon";
    in property <string> device-name: "BEACN Studio";
    in property <string> device-serial: "Unavailable";
    in property <string> device-firmware: "Unavailable";
    in property <bool> driverless-mode: false;
    in property <float> microphone-gain-db: 0;
    in property <bool> phantom-power: false;
    in property <float> headphone-volume-percent: 0;
    in property <float> headphone-monitor-percent: 0;
    in property <bool> headphone-channels-linked: false;
    in property <string> headphone-output-mode: "line_level";
    in property <float> mic-output-gain-db: 0;
    in property <bool> headphone-subwoofer-enabled: false;
    in-out property <float> headphone-subwoofer-amount: 0;
    in-out property <float> lighting-speed: 0;
    in-out property <float> lighting-brightness: 100;
    in-out property <int> lighting-style: 2;
    in-out property <int> lighting-muted-mode: 1;
    in-out property <int> lighting-suspended-mode: 1;
    in-out property <float> lighting-suspended-brightness: 50;
    in-out property <int> lighting-colour-index: 0;
    in-out property <bool> start-at-login: false;
    in-out property <bool> open-to-system-tray: true;
    in-out property <bool> save-confirmation: true;
    in-out property <bool> beta-opt-in: false;
    in-out property <bool> mixing-suite-enabled: true;
    in-out property <bool> automatic-default-reset: true;
    in-out property <bool> meter-crossfade: true;
    in-out property <bool> studio-profiles-expanded: true;
    in-out property <bool> mixer-profiles-expanded: true;
    in-out property <bool> legal-dialog-open: false;
    in-out property <bool> profile-save-confirm-open: false;
    in-out property <string> pending-profile-save: "";
    in-out property <bool> hotkey-editor-open: false;
    in-out property <string> hotkey-editor-action: "";
    in-out property <string> hotkey-editor-label: "";
    in-out property <string> hotkey-editor-input: "";
    in-out property <string> hotkey-editor-key-label: "";
    in-out property <string> last-application-drag: "";
    in-out property <bool> application-pointer-dragging: false;
    in-out property <length> application-pointer-x: 0px;
    in-out property <length> application-pointer-y: 0px;
    in-out property <string> dragged-application-process: "";

    callback refresh;
    callback set-volume(string, string, float);
    callback set-target-volume(string, float);
    callback set-default-input(string);
    callback set-default-output(string);
    callback set-source-mute(string, string, bool);
    callback set-source-mute-action(string, string);
    callback reorder-source(string, float);
    callback set-volume-linked(string, bool);
    callback set-route(string, string, bool);
    callback create-source(string);
    callback remove-source(string);
    callback create-mixer-profile;
    callback save-mixer-profile(string);
    callback duplicate-mixer-profile(string);
    callback load-mixer-profile(string);
    callback delete-mixer-profile(string);
    callback save-hotkey(string, string);
    callback normalize-hotkey(string, bool, bool, bool, bool) -> string;
    callback hotkey-key-label(string) -> string;
    pure callback source-name-available(string, string) -> bool;
    callback assign-linux-application(string, string, int);
    callback assign-link-application(string, int);
    callback select-dsp-module(string);
    callback select-dsp-mode(bool);
    callback select-eq-band(int);
    callback set-eq-band-type(string);
    callback adjust-eq-band(string, int);
    callback set-eq-band-value(string, float);
    callback add-eq-band;
    callback remove-eq-band;
    callback set-enhancement-preset(int);
    callback set-enhancement-value(string, float);
    callback set-headphone-eq-band(int, float);
    callback set-headphone-subwoofer(float);
    callback set-dsp-enabled(bool);
    callback select-noise-style(bool);
    callback load-dsp;
    callback arm-dsp;
    callback disarm-dsp;
    callback apply-dsp(float, float, float, float);
    callback revert-dsp;
    callback save-preferences(bool, bool, bool, bool, bool, bool, bool);
    callback save-profile-expansion(bool, bool);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 28px;
            background: #202023;
            border-width: 1px;
            border-color: #2c2c30;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                Text { text: "◇  STUDIOBRIDGE"; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: root.daemon-connected ? "CONNECTED" : "OFFLINE"; color: root.daemon-connected ? Theme.teal : Theme.red; font-size: 9px; font-weight: 800; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            Rectangle {
            width: 72px;
            background: #171719;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 7px;
                spacing: 5px;
                RailButton { glyph: "☷"; label: "MIXER"; active: root.active-page == 0; clicked => { root.active-page = 0; } }
                RailButton { glyph: "▣"; label: "STUDIO"; active: root.active-page >= 1 && root.active-page <= 3; clicked => { root.active-page = 1; root.dsp-selected-module = "mic_setup"; } }
                RailButton { glyph: "◉"; label: "MIC"; active: root.active-page == 1; clicked => { root.active-page = 1; root.dsp-selected-module = "mic_setup"; } }
                RailButton { glyph: "✦"; label: "LIGHTING"; active: root.active-page == 2; clicked => { root.active-page = 2; } }
                RailButton { glyph: "⚙"; label: "DEVICE"; active: root.active-page == 3; clicked => { root.active-page = 3; } }
                Rectangle { vertical-stretch: 1; }
                RailButton { glyph: "⚙"; label: "SETTINGS"; active: root.active-page == 4; clicked => { root.active-page = 4; } }
            }
        }

            VerticalLayout {
                spacing: 0px;

            if root.active-page == 0: VerticalLayout {
                padding: 8px;
                spacing: 5px;
                Rectangle {
                    height: 400px;
                    clip: true;
                    horizontal-stretch: 1;
                    background: transparent;
                    source-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        HorizontalLayout {
                            spacing: 4px;
                            for source[index] in root.sources: SourceStrip {
                                source: source;
                                source-index: index;
                                application-dragging: root.application-pointer-dragging;
                                application-drag-x: root.application-pointer-x;
                                application-drag-y: root.application-pointer-y;
                                personal-changed(value) => { root.set-volume(source.channel-id, "personal", value); }
                                audience-changed(value) => { root.set-volume(source.channel-id, "audience", value); }
                                personal-mute => { root.set-source-mute(source.channel-id, "personal", !source.personal-muted); }
                                audience-mute => { root.set-source-mute(source.channel-id, "audience", !source.audience-muted); }
                                mute-action(action) => {
                                    if action == "all" {
                                        root.set-source-mute(source.channel-id, "all", !(source.personal-muted && source.audience-muted));
                                    } else if action == "personal" {
                                        root.set-source-mute(source.channel-id, "personal", !source.personal-muted);
                                    } else {
                                        root.set-source-mute(source.channel-id, "audience", !source.audience-muted);
                                    }
                                }
                                mute-action-selected(action) => { root.set-source-mute-action(source.channel-id, action); }
                                reorder-requested(position) => { root.reorder-source(source.channel-id, position); }
                                link-changed(linked) => { root.set-volume-linked(source.channel-id, linked); }
                                delete-source => { root.remove-source(source.channel-id); }
                            }
                            Rectangle {
                                width: 133px; height: 398px; background: #19191c; border-width: 1px; border-color: Theme.border; border-radius: 2px;
                                Text { text: "+"; color: Theme.quiet; font-size: 42px; font-weight: 200; horizontal-alignment: center; vertical-alignment: center; }
                                add-source-focus := FocusScope {
                                    width: parent.width; height: parent.height;
                                    accessible-role: button;
                                    accessible-label: "Add mixer source";
                                    key-pressed(event) => {
                                        if event.text == Key.Return || event.text == Key.Space {
                                            if add-source-menu.is-open { add-source-menu.close(); } else { add-source-menu.show(); }
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    TouchArea {
                                        clicked => {
                                            add-source-focus.focus();
                                            if add-source-menu.is-open { add-source-menu.close(); } else { add-source-menu.show(); }
                                        }
                                    }
                                }
                                add-source-menu := PopupWindow {
                                    x: -18px; y: 196px; width: 82px; height: 238px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        width: parent.width; height: parent.height;
                                        background: #27272b; border-width: 1px; border-color: #242326;
                                        VerticalLayout {
                                            padding: 2px; spacing: 0px;
                                            AddSourceRow { label: "Mic"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Game"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Music"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Chat"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Browser"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "System"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Aux 1"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Aux 2"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Hardware"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Link In"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Link 2 In"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Link 3 In"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                            AddSourceRow { label: "Link 4 In"; available: root.source-name-available(self.label, root.source-name-key); selected(name) => { add-source-menu.close(); root.create-source(name); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 74px;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    clip: true;
                    HorizontalLayout {
                        spacing: 0px;
                        ScrollView {
                            // The native BEACN viewport ends after Personal and
                            // Audience. Extra StudioBridge buses remain reachable
                            // by scrolling this device region horizontally.
                            width: 812px;
                            height: parent.height;
                            viewport-width: root.targets.length * 403px + 12px;
                            viewport-height: parent.height;
                            mouse-drag-pan-enabled: true;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-on;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 5px;
                                for target in root.targets: TargetStrip {
                                    target: target;
                                    output-device-names: root.default-output-names;
                                    output-device-index: root.default-output-index;
                                    volume-changed(value) => { root.set-target-volume(target.target-id, value); }
                                    output-device-selected(index) => {
                                        if index >= 0 && index < root.default-output-ids.length {
                                            root.set-default-output(root.default-output-ids[index]);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }

                Rectangle {
                    height: 34px;
                    background: #0f1517;
                    HorizontalLayout {
                        spacing: 0px;
                        ContextTab { tab-width: 126px; label: "ASSIGNMENTS"; active: root.mixer-context-page == 0; clicked => { root.mixer-context-page = 0; } }
                        ContextTab { tab-width: 135px; label: "ROUTING TABLE"; active: root.mixer-context-page == 1; clicked => { root.mixer-context-page = 1; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.mixer-context-page == 0: HorizontalLayout {
                    spacing: 3px;
                    vertical-stretch: 1;
                    Rectangle {
                        width: 250px;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 7px;
                            Text { text: "RECORDING DEVICES"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "DEFAULT"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            BeacnSelector { width: 205px; height: 27px; model: root.default-input-names; current-index: root.default-input-index; placeholder: "Choose Audio to input..."; popup-width: 232px; selected(index) => { if index >= 0 && index < root.default-input-ids.length { root.set-default-input(root.default-input-ids[index]); } } }
                            Text { text: "VOD / RECORDING"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            Rectangle { height: 28px; background: Theme.raised; Text { x: 7px; text: "VOD Track · configure in Routing Table"; color: Theme.text; font-size: 9px; vertical-alignment: center; } }
                            Text { text: "DEFAULT PLAYBACK DEVICE"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            BeacnSelector { width: 205px; height: 27px; model: root.default-output-names; current-index: root.default-output-index; popup-width: 232px; selected(index) => { if index >= 0 && index < root.default-output-ids.length { root.set-default-output(root.default-output-ids[index]); } } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        width: 250px;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 6px;
                            Text { text: "OUTGOING STUDIO LINK ASSIGNMENTS"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "Multiple Windows apps may share a Link channel"; color: Theme.quiet; font-size: 9px; }
                            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 6px; for app in root.link-applications: AssignmentRow { title: app.name; HorizontalLayout { padding-left: 10px; padding-right: 8px; Text { text: app.name; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-stretch: 1; } BeacnSelector { width: 140px; model: root.link-channel-names; current-index: app.channel-index; popup-width: 180px; selected(index) => { root.assign-link-application(app.name, index); } } } } } }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 6px;
                            Text { text: "APPLICATIONS"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "Drag applications onto a source, or use the selector"; color: Theme.quiet; font-size: 9px; }
                            Text { height: 14px; text: root.last-application-drag; color: Theme.teal; font-size: 8px; }
                            unassign-target := Rectangle {
                                height: 25px;
                                property <bool> drag-hovered: root.application-pointer-dragging
                                    && root.application-pointer-x >= self.absolute-position.x
                                    && root.application-pointer-x < self.absolute-position.x + self.width
                                    && root.application-pointer-y >= self.absolute-position.y
                                    && root.application-pointer-y < self.absolute-position.y + self.height;
                                border-width: 1px; border-color: self.drag-hovered ? Theme.red : Theme.border;
                                background: self.drag-hovered ? #43221f : #1b1b1e;
                                Text { text: "UNASSIGNED DROP TARGET"; color: unassign-target.drag-hovered ? #f0b0aa : Theme.quiet; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 6px;
                                    for app in root.linux-applications: AssignmentRow {
                                        title: app.title;
                                        background: root.application-pointer-dragging && root.dragged-application-process == app.process ? #24413f : Theme.raised;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 6px; spacing: 6px;
                                            Rectangle {
                                                width: 18px;
                                                height: parent.height;
                                                Text { text: "⠿"; color: root.application-pointer-dragging && root.dragged-application-process == app.process ? Theme.teal : #626167; font-size: 10px; vertical-alignment: center; }
                                                app-drag-touch := TouchArea {
                                                    mouse-cursor: root.application-pointer-dragging && root.dragged-application-process == app.process ? MouseCursor.grabbing : MouseCursor.grab;
                                                    pointer-event(event) => {
                                                        let pointer-x = self.absolute-position.x + self.mouse-x;
                                                        let pointer-y = self.absolute-position.y + self.mouse-y;
                                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                                            root.application-pointer-dragging = true;
                                                            root.dragged-application-process = app.process;
                                                            root.application-pointer-x = pointer-x;
                                                            root.application-pointer-y = pointer-y;
                                                            root.last-application-drag = "Dragging " + app.title;
                                                        } else if event.kind == PointerEventKind.move && root.application-pointer-dragging && root.dragged-application-process == app.process {
                                                            root.application-pointer-x = pointer-x;
                                                            root.application-pointer-y = pointer-y;
                                                        } else if event.kind == PointerEventKind.up && root.application-pointer-dragging && root.dragged-application-process == app.process {
                                                            root.application-pointer-x = pointer-x;
                                                            root.application-pointer-y = pointer-y;
                                                            root.application-pointer-dragging = false;
                                                            root.dragged-application-process = "";
                                                            if pointer-x >= unassign-target.absolute-position.x
                                                                && pointer-x < unassign-target.absolute-position.x + unassign-target.width
                                                                && pointer-y >= unassign-target.absolute-position.y
                                                                && pointer-y < unassign-target.absolute-position.y + unassign-target.height {
                                                                root.assign-linux-application(app.process, app.name, 0);
                                                                root.last-application-drag = app.title + " unassigned";
                                                            } else if pointer-x >= source-scroll.absolute-position.x
                                                                && pointer-x < source-scroll.absolute-position.x + source-scroll.width
                                                                && pointer-y >= source-scroll.absolute-position.y
                                                                && pointer-y < source-scroll.absolute-position.y + source-scroll.height {
                                                                let source-position = floor((pointer-x - source-scroll.absolute-position.x - source-scroll.viewport-x) / 137px);
                                                                if source-position >= 0 && source-position < root.sources.length {
                                                                    root.assign-linux-application(app.process, app.name, source-position + 1);
                                                                    root.last-application-drag = app.title + " assigned to " + root.sources[source-position].name;
                                                                } else {
                                                                    root.last-application-drag = "Application drag cancelled";
                                                                }
                                                            } else {
                                                                root.last-application-drag = "Application drag cancelled";
                                                            }
                                                        } else if event.kind == PointerEventKind.cancel {
                                                            root.application-pointer-dragging = false;
                                                            root.dragged-application-process = "";
                                                            root.last-application-drag = "Application drag cancelled";
                                                        }
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                Text { text: app.title; color: Theme.text; font-size: 11px; font-weight: 700; overflow: elide; }
                                                Text { text: app.process; color: Theme.quiet; font-size: 8px; overflow: elide; }
                                            }
                                            BeacnSelector { width: 94px; model: root.mixer-channel-names; current-index: app.channel-index; placeholder: "Unassigned"; popup-width: 140px; selected(index) => { root.assign-linux-application(app.process, app.name, index); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                if root.mixer-context-page == 1: ScrollView {
                    vertical-stretch: 1;
                    GridLayout {
                        x: 179px;
                        y: 8px;
                        spacing: 0px;
                        for route in root.routes: RoutingToggle {
                            row: route.row + 1;
                            col: route.column + 1;
                            route: route;
                            toggled => { root.set-route(route.source-id, route.target-id, !route.enabled); }
                        }
                        for route in root.routes: Rectangle {
                            visible: route.row == 0;
                            row: 0; col: route.column + 1; width: 90px; height: 34px; background: #1c1c1f;
                            border-width: 1px; border-color: #2e2e32;
                            Text { text: route.source-id == "microphone" ? "Mic Relay" : route.source-name; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                        for route in root.routes: Rectangle {
                            visible: route.column == 0;
                            row: route.row + 1; col: 0; width: 112px; height: 34px; background: transparent;
                            Rectangle {
                                y: 5px; width: parent.width; height: 28px;
                                background: #1c1c1f; border-width: 1px; border-color: #2e2e32;
                                Text { x: 5px; width: parent.width - 10px; text: (route.target-id == "headphones" ? "Personal Mix" : route.target-name) + (route.target-id == "voice-chat-mic" ? " ⌄" : ""); color: Theme.text; font-size: 10px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
            }

            if root.active-page == 1: HorizontalLayout {
                spacing: 0px;
                VerticalLayout {
                    width: 897px;
                    spacing: 0px;
                    Rectangle {
                        height: 280px;
                        background: #202023;
                    Rectangle {
                        x: 28px; y: 20px; width: 864px; height: 256px;
                        border-width: 1px; border-color: Theme.border; background: #0d1214;
                        Rectangle { x: 0px; y: parent.height * 0.50; width: parent.width * 0.22; height: parent.height * 0.22; background: #421d20; opacity: 0.75; }
                        Rectangle { x: parent.width * 0.22; y: parent.height * 0.44; width: parent.width * 0.28; height: parent.height * 0.12; background: #173b3b; opacity: 0.55; }
                        Rectangle { x: parent.width * 0.50; y: parent.height * 0.48; width: parent.width * 0.25; height: parent.height * 0.13; background: #443917; opacity: 0.55; }
                        Rectangle { x: parent.width * 0.75; y: parent.height * 0.45; width: parent.width * 0.25; height: parent.height * 0.11; background: #43172b; opacity: 0.55; }
                        Rectangle { x: 0px; y: parent.height * 0.5; width: parent.width; height: 1px; background: #354045; }
                        Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #222c30; }
                        Rectangle { x: parent.width * 0.5; width: 1px; height: parent.height; background: #222c30; }
                        Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #222c30; }
                        Path {
                            width: parent.width;
                            height: parent.height;
                            commands: "M 0 230 C 70 155 120 125 210 120 C 310 113 370 160 455 155 C 560 149 620 117 710 119 C 800 121 850 115 920 113";
                            fill: transparent;
                            stroke: #efefed;
                            stroke-width: 2px;
                        }
                        Path {
                            width: parent.width;
                            height: parent.height;
                            commands: "M 0 242 C 55 237 95 247 145 236 C 205 226 260 250 320 239 C 390 226 450 251 520 238 C 600 228 690 248 770 237 C 835 232 875 244 920 238";
                            fill: transparent;
                            stroke: #65656a;
                            stroke-width: 1px;
                        }
                        if root.eq-guide: Rectangle { x: 8px; y: 26px; width: 155px; height: 38px; background: #111518cc; border-width: 1px; border-color: Theme.border; Text { x: 7px; width: parent.width - 14px; text: "Drag-free guarded EQ\nSelect a point, then use controls below"; color: Theme.quiet; font-size: 8px; wrap: word-wrap; vertical-alignment: center; } }
                        for band in root.eq-bands: Rectangle {
                            x: (parent.width - 18px) * band.x-percent / 100;
                            y: 18px + (parent.height - 36px) * band.y-percent / 100;
                            width: band.selected ? 18px : 14px;
                            height: self.width;
                            border-radius: self.width / 2;
                            border-width: band.selected ? 3px : 1px;
                            border-color: band.selected ? #ffffff : #171719;
                            background: band.colour;
                            opacity: band.enabled ? 1 : 0.32;
                            band-focus := FocusScope {
                                width: parent.width; height: parent.height;
                                accessible-role: button;
                                accessible-label: "Select EQ band " + (band.band-index + 1);
                                key-pressed(event) => {
                                    if event.text == Key.Return || event.text == Key.Space {
                                        root.select-eq-band(band.band-index);
                                        return accept;
                                    }
                                    return reject;
                                }
                                TouchArea { clicked => { band-focus.focus(); root.select-eq-band(band.band-index); } }
                            }
                        }
                        Text { x: parent.width * 0.05; y: 10px; text: "30"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.18; y: 10px; text: "100"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.32; y: 10px; text: "250"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.45; y: 10px; text: "500"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.58; y: 10px; text: "1k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.70; y: 10px; text: "2k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.82; y: 10px; text: "5k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.92; y: 10px; text: "16k"; color: #77777d; font-size: 9px; }
                    }
                }

                HorizontalLayout {
                    height: 150px;
                    spacing: 3px;
                    Rectangle {
                        width: 438px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "equalizer" ? Theme.teal : Theme.border;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                width: 150px;
                                spacing: 5px;
                                HorizontalLayout {
                                    height: 25px; spacing: 4px;
                                    Button { horizontal-stretch: 1; text: "ADD BAND"; enabled: root.dsp-active-module == "equalizer" && root.eq-can-add-band; clicked => { root.add-eq-band(); } }
                                    Button { width: 28px; text: "−"; enabled: root.dsp-active-module == "equalizer" && root.eq-band-enabled; clicked => { root.remove-eq-band(); } }
                                }
                                Text { text: "Presets"; color: Theme.quiet; font-size: 9px; }
                                Rectangle { height: 24px; background: #1a1a1d; Text { x: 6px; text: "Custom / read-back"; color: Theme.text; font-size: 9px; vertical-alignment: center; } }
                                HorizontalLayout { height: 22px; Text { text: "Advanced EQ"; color: Theme.quiet; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } ToggleSwitch { checked: root.eq-advanced; interactive: root.dsp-active-module == "equalizer"; control-label: "Advanced EQ"; toggled(value) => { root.select-dsp-mode(value); } } }
                                HorizontalLayout { height: 22px; Text { text: "Guide"; color: Theme.quiet; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } ToggleSwitch { checked: root.eq-guide; control-label: "EQ guide"; toggled(value) => { root.eq-guide = value; } } }
                            }
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                GridLayout {
                                    width: 120px; spacing: 3px;
                                    EqTypeButton { row: 0; col: 0; glyph: "⌒"; label: "Low-pass filter"; selected: root.eq-band-type == "low_pass"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("low_pass"); } }
                                    EqTypeButton { row: 0; col: 1; glyph: "⌊"; label: "Low shelf"; selected: root.eq-band-type == "low_shelf"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("low_shelf"); } }
                                    EqTypeButton { row: 0; col: 2; glyph: "⌁"; label: "Notch filter"; selected: root.eq-band-type == "notch"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("notch"); } }
                                    EqTypeButton { row: 1; col: 0; glyph: "⌄"; label: "Bell band"; selected: root.eq-band-type == "bell"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("bell"); } }
                                    EqTypeButton { row: 1; col: 1; glyph: "⌉"; label: "High shelf"; selected: root.eq-band-type == "high_shelf"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("high_shelf"); } }
                                    EqTypeButton { row: 1; col: 2; glyph: "∿"; label: "High-pass filter"; selected: root.eq-band-type == "high_pass"; interactive: root.dsp-active-module == "equalizer"; clicked => { root.set-eq-band-type("high_pass"); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 4px;
                                    Rectangle { vertical-stretch: 1; }
                                    ProcessorValueRow { height: 28px; label: "FREQ"; value-label: round(root.eq-frequency-hz) + "Hz"; interactive: root.dsp-active-module == "equalizer"; decrease => { root.adjust-eq-band("frequency", -1); } increase => { root.adjust-eq-band("frequency", 1); } }
                                    ProcessorValueRow { height: 28px; label: "GAIN"; value-label: round(root.eq-gain-db * 10) / 10 + "dB"; interactive: root.dsp-active-module == "equalizer"; decrease => { root.adjust-eq-band("gain", -1); } increase => { root.adjust-eq-band("gain", 1); } }
                                    ProcessorValueRow { height: 28px; label: "Q"; value-label: round(root.eq-q * 10) / 10 + ""; interactive: root.dsp-active-module == "equalizer"; decrease => { root.adjust-eq-band("q", -1); } increase => { root.adjust-eq-band("q", 1); } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                        TouchArea { x: 0px; y: 0px; width: parent.width; height: 8px; clicked => { root.select-dsp-module("equalizer"); } }
                    }
                    Rectangle {
                        width: 203px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "enhancement_suite" ? Theme.teal : Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            Text { text: "BASS ENHANCE"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout {
                                height: 34px; spacing: 5px;
                                EnhancementPresetButton { preset: 1; selected: root.enhancement-bass-preset == 1; interactive: root.dsp-active-module == "enhancement_suite"; clicked => { root.set-enhancement-preset(1); } }
                                EnhancementPresetButton { preset: 2; selected: root.enhancement-bass-preset == 2; interactive: root.dsp-active-module == "enhancement_suite"; clicked => { root.set-enhancement-preset(2); } }
                                EnhancementPresetButton { preset: 3; selected: root.enhancement-bass-preset == 3; interactive: root.dsp-active-module == "enhancement_suite"; clicked => { root.set-enhancement-preset(3); } }
                                EnhancementPresetButton { preset: 4; selected: root.enhancement-bass-preset == 4; interactive: root.dsp-active-module == "enhancement_suite"; clicked => { root.set-enhancement-preset(4); } }
                            }
                            HorizontalLayout {
                                EnhancementDial { label: "DE-ESSER"; control-label: "De-Esser amount"; value: root.enhancement-de-esser-amount; value-label: ""; dial-accessible-value: round(root.enhancement-de-esser-amount) + "%"; minimum: 0; maximum: 100; step: 1; enabled-state: root.enhancement-de-esser-enabled; interactive: root.dsp-active-module == "enhancement_suite"; changed(value) => { root.set-enhancement-value("de_esser_amount", value); } }
                                EnhancementDial { label: "AMOUNT"; control-label: "Bass Enhance amount"; value: root.enhancement-bass-amount; value-label: ""; dial-accessible-value: round(root.enhancement-bass-amount * 10) / 10 + ""; minimum: 0; maximum: 10; step: 0.5; enabled-state: root.enhancement-bass-enabled; interactive: root.dsp-active-module == "enhancement_suite"; changed(value) => { root.set-enhancement-value("bass_amount", value); } }
                            }
                        }
                        TouchArea { x: 0px; y: 0px; width: parent.width; height: 20px; clicked => { root.select-dsp-module("enhancement_suite"); } }
                    }
                    Rectangle {
                        width: 201px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "enhancement_suite" ? Theme.teal : Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            Text { text: "EXCITER"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout {
                                EnhancementDial { label: "AMOUNT"; control-label: "Exciter amount"; value: root.enhancement-exciter-amount; value-label: ""; dial-accessible-value: round(root.enhancement-exciter-amount) + "%"; minimum: 0; maximum: 100; step: 1; enabled-state: root.enhancement-exciter-enabled; interactive: root.dsp-active-module == "enhancement_suite"; changed(value) => { root.set-enhancement-value("exciter_amount", value); } }
                                EnhancementDial { label: "FREQUENCY"; control-label: "Exciter frequency"; value: root.enhancement-exciter-frequency; value-label: round(root.enhancement-exciter-frequency) + "Hz"; minimum: 0; maximum: 5000; step: 100; enabled-state: root.enhancement-exciter-enabled; interactive: root.dsp-active-module == "enhancement_suite"; changed(value) => { root.set-enhancement-value("exciter_frequency", value); } }
                            }
                        }
                        TouchArea { x: 0px; y: 0px; width: parent.width; height: 20px; clicked => { root.select-dsp-module("enhancement_suite"); } }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 0px;
                        ModuleTab { tab-width: 81px; label: "MIC SETUP"; module: "mic_setup"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; } }
                        ModuleTab { tab-width: 161px; label: "NOISE SUPPRESSION"; module: "noise_suppression"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; root.select-dsp-module(module); } }
                        ModuleTab { tab-width: 80px; label: "EXPANDER"; module: "expander"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; root.select-dsp-module(module); } }
                        ModuleTab { tab-width: 101px; label: "COMPRESSOR"; module: "compressor"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; root.select-dsp-module(module); } }
                        ModuleTab { tab-width: 108px; label: "HEADPHONES"; module: "headphone_equalizer"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; root.select-dsp-module(module); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.dsp-selected-module == "mic_setup": Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px; border-color: Theme.border; background: Theme.panel;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 16px;
                        VerticalLayout {
                            width: 96px;
                            Text { text: "Mic Gain"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout { vertical-stretch: 1; Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: root.microphone-gain-db / 70 * 100; accent: Theme.teal; muted: false; personal: true; show-mute: false; } Rectangle { horizontal-stretch: 1; } }
                            Text { text: round(root.microphone-gain-db) + "dB"; color: Theme.teal; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #19191c;
                            border-width: 1px; border-color: Theme.border;
                            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height * 0.20; background: #8e7118; opacity: 0.75; }
                            Rectangle { x: 0px; y: parent.height * 0.20; width: parent.width; height: parent.height * 0.40; background: #237d79; opacity: 0.72; }
                            Rectangle { x: 0px; y: parent.height * 0.20; width: parent.width; height: 1px; background: #70611c; }
                            Rectangle { x: 0px; y: parent.height * 0.60; width: parent.width; height: 1px; background: #245d5a; }
                            Rectangle { x: 0px; y: parent.height * 0.76; width: parent.width; height: 1px; background: #303034; }
                            Rectangle { x: 0px; y: parent.height * 0.90; width: parent.width; height: 1px; background: #303034; }
                            Path {
                                width: parent.width; height: parent.height;
                                commands: "M 0 196 C 55 205 72 221 108 211 C 138 202 120 151 163 151 C 205 151 213 164 239 201 C 266 235 294 174 326 174 C 364 174 379 195 420 197 C 460 199 483 193 518 184 C 552 173 573 181 610 201 C 624 207 632 213 650 220";
                                fill: transparent; stroke: #efefed; stroke-width: 2px;
                            }
                            Text { x: 10px; y: 8px; text: "Peak Area"; color: Theme.text; font-size: 10px; font-weight: 700; }
                            Text { x: 10px; y: parent.height * 0.38; text: "Speaking Area"; color: Theme.text; font-size: 10px; font-weight: 700; }
                            Text { x: parent.width - 96px; y: parent.height * 0.48; text: round((root.microphone-meter * 0.7 - 70) * 10) / 10 + "dB"; color: #f2cf36; font-size: 22px; font-weight: 800; }
                        }
                        VerticalLayout {
                            width: 110px;
                            Text { text: "Phantom Power"; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-alignment: center; }
                            Rectangle { height: 28px; background: transparent; HorizontalLayout { Rectangle { horizontal-stretch: 1; } ToggleSwitch { checked: root.phantom-power; interactive: false; control-label: "Phantom power read-only state"; } Text { text: root.phantom-power ? "ON" : "OFF"; color: root.phantom-power ? Theme.red : Theme.quiet; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } } }
                            Rectangle { vertical-stretch: 1; }
                            Text { text: "Phantom power is permanently read-only in StudioBridge"; color: Theme.amber; font-size: 8px; wrap: word-wrap; }
                        }
                    }
                }

                if root.dsp-selected-module != "mic_setup": Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px; border-color: Theme.border; background: Theme.panel;
                    VerticalLayout {
                        padding: 0px; spacing: 0px;
                        if root.dsp-selected-module != "headphone_equalizer": HorizontalLayout {
                            height: 18px; padding-left: 10px; padding-right: 8px;
                            Text { text: root.dsp-editor-title; color: Theme.quiet; font-size: 9px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                            StatusPill { width: 112px; height: 16px; horizontal-stretch: 0; label: root.dsp-active-module == root.dsp-selected-module ? "EDITING " + root.dsp-lease-seconds + "s" : "READ ONLY"; good: root.dsp-active-module == root.dsp-selected-module; }
                        }

                        if root.dsp-selected-module == "equalizer": HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                width: 330px; spacing: 7px;
                                Text { text: "BAND " + (root.eq-selected-band + 1) + " FREQUENCY   " + round(root.eq-frequency-hz) + " Hz"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.eq-frequency-hz; minimum: 20; maximum: 20000; changed(value) => { root.set-eq-band-value("frequency", value); } }
                                Text { text: "GAIN   " + round(root.eq-gain-db * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.eq-gain-db; minimum: -12; maximum: 12; changed(value) => { root.set-eq-band-value("gain", value); } }
                                Text { text: "Q   " + round(root.eq-q * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.eq-q; minimum: 0.1; maximum: 10; changed(value) => { root.set-eq-band-value("q", value); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #111518; border-width: 1px; border-color: Theme.border;
                                Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { y: parent.height * 0.50; width: parent.width; height: 1px; background: #343a3d; }
                                Path { width: parent.width; height: parent.height; commands: "M 0 94 C 120 94 150 48 245 54 C 340 60 370 118 470 105 C 570 92 625 58 720 62 C 800 66 850 70 900 70"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Text { x: 8px; y: 8px; text: "Guarded read-back voice EQ"; color: Theme.quiet; font-size: 9px; }
                            }
                        }

                        if root.dsp-selected-module == "enhancement_suite": HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                width: 330px; spacing: 7px;
                                Text { text: "BASS AMOUNT   " + round(root.enhancement-bass-amount * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.enhancement-bass-amount; minimum: 0; maximum: 10; changed(value) => { root.set-enhancement-value("bass_amount", value); } }
                                Text { text: "DE-ESSER   " + round(root.enhancement-de-esser-amount) + "%"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.enhancement-de-esser-amount; minimum: 0; maximum: 100; changed(value) => { root.set-enhancement-value("de_esser_amount", value); } }
                                Text { text: "EXCITER   " + round(root.enhancement-exciter-amount) + "%"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.enhancement-exciter-amount; minimum: 0; maximum: 100; changed(value) => { root.set-enhancement-value("exciter_amount", value); } }
                                Text { text: "EXCITER FREQUENCY   " + round(root.enhancement-exciter-frequency) + " Hz"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.enhancement-exciter-frequency; minimum: 0; maximum: 5000; changed(value) => { root.set-enhancement-value("exciter_frequency", value); } }
                            }
                            HorizontalLayout {
                                horizontal-stretch: 1; spacing: 12px;
                                Dial { label: "BASS"; value-label: round(root.enhancement-bass-amount * 10) / 10 + ""; active: root.enhancement-bass-enabled; }
                                Dial { label: "DE-ESSER"; value-label: round(root.enhancement-de-esser-amount) + "%"; active: root.enhancement-de-esser-enabled; }
                                Dial { label: "EXCITER"; value-label: round(root.enhancement-exciter-amount) + "%"; active: root.enhancement-exciter-enabled; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        if root.dsp-selected-module == "noise_suppression": HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 200px; background: #202023;
                                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
                                VerticalLayout {
                                    padding-left: 10px; padding-right: 24px; padding-top: 5px; padding-bottom: 5px; spacing: 3px;
                                    HorizontalLayout { height: 20px; ToggleSwitch { checked: root.dsp-enabled; interactive: root.dsp-active-module == root.dsp-selected-module; control-label: "Noise Suppression enabled"; toggled(value) => { root.set-dsp-enabled(value); } } Text { text: root.dsp-enabled ? "On" : "Off"; color: Theme.text; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                                    Text { height: 16px; text: "Style"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
                                    HorizontalLayout {
                                        height: 32px; spacing: 4px;
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Adaptive"; selected: !root.noise-snapshot; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-noise-style(false); } }
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Snapshot"; selected: root.noise-snapshot; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-noise-style(true); } }
                                    }
                                    Rectangle { height: 8px; }
                                    Text { height: 16px; text: "Amount"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
                                    HorizontalLayout { height: 26px; spacing: 5px; Text { width: 34px; text: round(root.dsp-value-a) + "%"; color: Theme.text; font-size: 10px; vertical-alignment: center; } Slider { horizontal-stretch: 1; enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } } }
                                    Text { height: 16px; text: "Sensitivity"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
                                    HorizontalLayout { height: 26px; spacing: 5px; Text { width: 34px; text: round(root.dsp-value-b) + "%"; color: Theme.text; font-size: 10px; vertical-alignment: center; } Slider { horizontal-stretch: 1; enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #15191b;
                                Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { y: parent.height * 0.50; width: parent.width; height: 1px; background: #242a2d; }
                                Rectangle { y: parent.height * 0.75; width: parent.width; height: 1px; background: #242a2d; }
                                Path { width: parent.width; height: parent.height; commands: "M 0 80 C 72 82 130 92 205 115 C 285 140 385 151 500 153 C 610 154 760 155 900 155"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Text { x: 8px; y: parent.height - 20px; text: root.noise-snapshot ? "Snapshot profile" : "Adaptive noise floor"; color: Theme.quiet; font-size: 8px; }
                            }
                        }

                        if root.dsp-selected-module == "expander": HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 200px; background: #202023;
                                VerticalLayout {
                                    padding-left: 10px; padding-right: 24px; padding-top: 5px; padding-bottom: 4px; spacing: 3px;
                                    HorizontalLayout { height: 20px; ToggleSwitch { checked: root.dsp-enabled; interactive: root.dsp-active-module == root.dsp-selected-module; control-label: "Expander enabled"; toggled(value) => { root.set-dsp-enabled(value); } } Text { text: root.dsp-enabled ? "On" : "Off"; color: Theme.text; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                                    HorizontalLayout {
                                        height: 50px;
                                        Text { width: 18px; text: "‹"; color: root.dsp-active-module == root.dsp-selected-module ? Theme.text : #55555a; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; TouchArea { enabled: root.dsp-active-module == root.dsp-selected-module; clicked => { root.dsp-value-a = root.dsp-value-a - 1 < root.dsp-min-a ? root.dsp-min-a : root.dsp-value-a - 1; } } }
                                        Text { horizontal-stretch: 1; text: round(root.dsp-value-a) + "dB"; color: Theme.text; font-size: 22px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { width: 18px; text: "›"; color: root.dsp-active-module == root.dsp-selected-module ? Theme.text : #55555a; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; TouchArea { enabled: root.dsp-active-module == root.dsp-selected-module; clicked => { root.dsp-value-a = root.dsp-value-a + 1 > root.dsp-max-a ? root.dsp-max-a : root.dsp-value-a + 1; } } }
                                    }
                                    HorizontalLayout { height: 32px; spacing: 6px;
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Simple"; selected: !root.dsp-advanced; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-dsp-mode(false); } }
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Advanced"; selected: root.dsp-advanced; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-dsp-mode(true); } }
                                    }
                                    Rectangle { height: 7px; }
                                    ProcessorValueRow { label: root.dsp-advanced ? "Ratio" : "Amount"; value-label: round(root.dsp-value-b * 10) / 10 + (root.dsp-advanced ? ":1" : "%"); interactive: root.dsp-active-module == root.dsp-selected-module; decrease => { root.dsp-value-b = root.dsp-value-b - 0.1 < root.dsp-min-b ? root.dsp-min-b : root.dsp-value-b - 0.1; } increase => { root.dsp-value-b = root.dsp-value-b + 0.1 > root.dsp-max-b ? root.dsp-max-b : root.dsp-value-b + 0.1; } }
                                    if root.dsp-advanced: ProcessorValueRow { label: "Attack"; value-label: round(root.dsp-value-c * 10) / 10 + "ms"; interactive: root.dsp-active-module == root.dsp-selected-module; decrease => { root.dsp-value-c = root.dsp-value-c - 1 < root.dsp-min-c ? root.dsp-min-c : root.dsp-value-c - 1; } increase => { root.dsp-value-c = root.dsp-value-c + 1 > root.dsp-max-c ? root.dsp-max-c : root.dsp-value-c + 1; } }
                                    if root.dsp-advanced: ProcessorValueRow { label: "Release"; value-label: round(root.dsp-value-d * 10) / 10 + "ms"; interactive: root.dsp-active-module == root.dsp-selected-module; decrease => { root.dsp-value-d = root.dsp-value-d - 1 < root.dsp-min-d ? root.dsp-min-d : root.dsp-value-d - 1; } increase => { root.dsp-value-d = root.dsp-value-d + 1 > root.dsp-max-d ? root.dsp-max-d : root.dsp-value-d + 1; } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #15191b;
                                Rectangle { width: 1px; height: parent.height; background: Theme.border; }
                                for label[i] in ["0", "-20", "-40", "-60", "-80", "-100"]: Text { x: 6px; y: i * (parent.height - 14px) / 5; width: 28px; height: 14px; text: label; color: Theme.quiet; font-size: 8px; }
                                Rectangle { x: 35px; y: parent.height * 0.42; width: parent.width - 35px; height: 1px; background: #dedee0; }
                                Path { x: 35px; width: parent.width - 35px; height: parent.height; commands: "M 0 175 L 180 175 C 245 175 285 142 340 112 L 480 18 L 900 18"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Path { x: 35px; width: parent.width - 35px; height: parent.height; commands: "M 0 202 C 110 194 185 198 265 187 C 345 176 430 194 520 186 C 620 178 735 190 900 183"; fill: transparent; stroke: #a7464d; stroke-width: 2px; }
                            }
                        }

                        if root.dsp-selected-module == "compressor": HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 293px; background: #202023;
                                VerticalLayout {
                                    padding-left: 10px; padding-right: 34px; padding-top: 5px; padding-bottom: 4px; spacing: 3px;
                                    HorizontalLayout { height: 20px; ToggleSwitch { checked: root.dsp-enabled; interactive: root.dsp-active-module == root.dsp-selected-module; control-label: "Compressor enabled"; toggled(value) => { root.set-dsp-enabled(value); } } Text { text: root.dsp-enabled ? "On" : "Off"; color: Theme.text; font-size: 9px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                                    HorizontalLayout {
                                        height: 50px;
                                        Text { width: 18px; text: "‹"; color: root.dsp-active-module == root.dsp-selected-module ? Theme.text : #55555a; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; TouchArea { enabled: root.dsp-active-module == root.dsp-selected-module; clicked => { root.dsp-value-a = root.dsp-value-a - 1 < root.dsp-min-a ? root.dsp-min-a : root.dsp-value-a - 1; } } }
                                        Text { horizontal-stretch: 1; text: round(root.dsp-value-a) + "dB"; color: Theme.text; font-size: 22px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { width: 18px; text: "›"; color: root.dsp-active-module == root.dsp-selected-module ? Theme.text : #55555a; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; TouchArea { enabled: root.dsp-active-module == root.dsp-selected-module; clicked => { root.dsp-value-a = root.dsp-value-a + 1 > root.dsp-max-a ? root.dsp-max-a : root.dsp-value-a + 1; } } }
                                    }
                                    HorizontalLayout { height: 32px; spacing: 6px;
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Simple"; selected: !root.dsp-advanced; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-dsp-mode(false); } }
                                        ProcessorModeButton { horizontal-stretch: 1; label: "Advanced"; selected: root.dsp-advanced; interactive: root.dsp-active-module == root.dsp-selected-module; clicked => { root.select-dsp-mode(true); } }
                                    }
                                    Rectangle { height: 8px; }
                                    Text { height: 16px; text: root.dsp-advanced ? "Ratio / Attack / Release" : "Compress Amount"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
                                    HorizontalLayout { height: 28px; spacing: 6px; Text { width: 36px; text: round(root.dsp-value-b) + "%"; color: Theme.text; font-size: 10px; vertical-alignment: center; } Slider { horizontal-stretch: 1; enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #19191c;
                                ProcessorMeter { x: 28px; y: 5px; width: 52px; height: parent.height - 9px; label: "INPUT"; value: root.microphone-meter; colour: Theme.teal; }
                                ProcessorMeter { x: 128px; y: 5px; width: 52px; height: parent.height - 9px; label: "ATTENUATION"; value: root.microphone-meter * 0.32; colour: Theme.amber; }
                                ProcessorMeter { x: 228px; y: 5px; width: 52px; height: parent.height - 9px; label: "OUTPUT"; value: root.microphone-meter * 0.88; colour: Theme.teal; }
                                VerticalLayout {
                                    x: 428px; y: 5px; width: 78px; height: parent.height - 9px; spacing: 3px;
                                    Text { height: 18px; text: "MAKE-UP GAIN"; color: Theme.quiet; font-size: 8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: (root.dsp-value-c - root.dsp-min-c) / (root.dsp-max-c - root.dsp-min-c) * 100; accent: Theme.teal; muted: false; personal: true; show-mute: false; interactive: root.dsp-active-module == root.dsp-selected-module; changed(value) => { root.dsp-value-c = root.dsp-min-c + value / 100 * (root.dsp-max-c - root.dsp-min-c); } } Rectangle { horizontal-stretch: 1; } }
                                    Text { height: 18px; text: round(root.dsp-value-c * 10) / 10 + "dB"; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }

                        if root.dsp-selected-module == "headphone_equalizer": HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 268px; background: #202023;
                                Text { x: 10px; y: 8px; text: "LEVEL CONTROLS"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                                VerticalLayout {
                                    x: 20px; y: 30px; width: 82px; height: parent.height - 38px; spacing: 3px;
                                    Text { height: 18px; text: "MIC MONITOR"; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: root.headphone-monitor-percent; accent: Theme.teal; muted: false; personal: true; show-mute: false; interactive: false; } Rectangle { horizontal-stretch: 1; } }
                                    Text { height: 18px; text: round((-100 + root.headphone-monitor-percent / 100 * 106) * 10) / 10 + "dB"; color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { x: 121px; y: parent.height / 2 - 12px; width: 26px; height: 24px; text: "∞"; color: root.headphone-channels-linked ? Theme.teal : Theme.quiet; font-size: 19px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                VerticalLayout {
                                    x: 164px; y: 30px; width: 82px; height: parent.height - 38px; spacing: 3px;
                                    Text { height: 18px; text: "HEADPHONES"; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: root.headphone-volume-percent; accent: Theme.teal; muted: false; personal: true; show-mute: false; interactive: false; } Rectangle { horizontal-stretch: 1; } }
                                    Text { height: 18px; text: round((-70 + root.headphone-volume-percent / 100 * 70) * 10) / 10 + "dB"; color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                width: 405px; background: #19191c;
                                Rectangle { width: 1px; height: parent.height; background: Theme.border; }
                                Text { x: 12px; y: 8px; text: "EQUALIZER"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                                HorizontalLayout { x: 12px; y: 25px; width: 92px; height: 20px; ToggleSwitch { checked: root.dsp-enabled; interactive: root.dsp-active-module == root.dsp-selected-module; control-label: "Headphone equalizer enabled"; toggled(value) => { root.set-dsp-enabled(value); } } Text { text: root.dsp-enabled ? "On" : "Off"; color: Theme.text; font-size: 9px; vertical-alignment: center; } }
                                HorizontalLayout {
                                    x: 48px; y: 49px; width: parent.width - 70px; height: 110px; spacing: 12px;
                                    ProcessorDial { label: "BASS"; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; interactive: root.dsp-active-module == root.dsp-selected-module; changed(value) => { root.set-headphone-eq-band(0, value); } }
                                    ProcessorDial { label: "MIDS"; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; interactive: root.dsp-active-module == root.dsp-selected-module; changed(value) => { root.set-headphone-eq-band(1, value); } }
                                    ProcessorDial { label: "TREBLE"; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; interactive: root.dsp-active-module == root.dsp-selected-module; changed(value) => { root.set-headphone-eq-band(2, value); } }
                                }
                                Text { x: 14px; y: parent.height - 50px; width: 76px; height: 16px; text: "SUBWOOFER"; color: Theme.quiet; font-size: 8px; font-weight: 700; vertical-alignment: center; }
                                Text { x: 78px; y: parent.height - 50px; width: 20px; height: 16px; text: round(root.headphone-subwoofer-amount); color: root.headphone-subwoofer-enabled ? Theme.teal : Theme.quiet; font-size: 8px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                                Slider { x: 106px; y: parent.height - 49px; width: parent.width - 128px; height: 18px; enabled: root.dsp-active-module == root.dsp-selected-module; value <=> root.headphone-subwoofer-amount; minimum: 0; maximum: 10; changed(value) => { root.set-headphone-subwoofer(value); } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #202023;
                                Rectangle { width: 1px; height: parent.height; background: Theme.border; }
                                VerticalLayout {
                                    padding-left: 18px; padding-right: 8px; padding-top: 8px; spacing: 10px;
                                    HorizontalLayout { height: 16px; Text { text: "AMP POWER"; color: Theme.quiet; font-size: 8px; font-weight: 800; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: "READ ONLY"; color: Theme.amber; font-size: 7px; font-weight: 800; vertical-alignment: center; } }
                                    ReadOnlyAmpOption { label: "In Ear Monitors"; selected: root.headphone-output-mode == "in_ear_monitors"; }
                                    ReadOnlyAmpOption { label: "Line Level"; selected: root.headphone-output-mode == "line_level"; }
                                    ReadOnlyAmpOption { label: "Normal Power"; selected: root.headphone-output-mode == "normal_power"; }
                                    ReadOnlyAmpOption { label: "High Impedance Mode"; selected: root.headphone-output-mode == "high_impedance"; }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 27px; padding-left: 8px; padding-right: 8px; spacing: 7px;
                            Button { text: "Reload read-back"; clicked => { root.load-dsp(); } }
                            if root.dsp-active-module == root.dsp-selected-module: Button { text: "Apply + verify"; clicked => { root.apply-dsp(root.dsp-value-a, root.dsp-value-b, root.dsp-value-c, root.dsp-value-d); } }
                            if root.dsp-active-module == root.dsp-selected-module: Button { text: "Revert captured"; clicked => { root.revert-dsp(); } }
                            if root.dsp-active-module != root.dsp-selected-module && !root.arm-confirm-pending: Button { text: "Enable editing for 5 minutes"; clicked => { root.arm-confirm-pending = true; } }
                            if root.dsp-active-module != root.dsp-selected-module && root.arm-confirm-pending: Button { text: "Confirm: this changes audio"; clicked => { root.arm-dsp(); } }
                            if root.arm-confirm-pending: Button { text: "Cancel"; clicked => { root.arm-confirm-pending = false; } }
                            if root.dsp-active-module != "": Button { text: "Disarm now"; clicked => { root.disarm-dsp(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { height: 11px; text: "General hardware writes remain OFF · phantom, firmware, reset, lighting, limiter guesses, and storage excluded"; color: Theme.amber; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                }
                Rectangle {
                    width: 150px;
                    border-width: 1px; border-color: Theme.border; background: #202023;
                    VerticalLayout {
                        spacing: 0px;
                        Text { height: 40px; text: "Mic Output"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle {
                            vertical-stretch: 1;
                            Text { x: 8px; y: 0px; text: "0"; color: Theme.quiet; font-size: 9px; }
                            Text { x: 5px; y: parent.height * 0.18; text: "-10"; color: Theme.quiet; font-size: 9px; }
                            Text { x: 5px; y: parent.height * 0.36; text: "-20"; color: Theme.quiet; font-size: 9px; }
                            Text { x: 5px; y: parent.height * 0.54; text: "-30"; color: Theme.quiet; font-size: 9px; }
                            Text { x: 5px; y: parent.height * 0.72; text: "-50"; color: Theme.quiet; font-size: 9px; }
                            Text { x: 5px; y: parent.height - 14px; text: "-70"; color: Theme.quiet; font-size: 9px; }
                            meter-track := Rectangle {
                                x: 50px; y: 0px; width: 50px; height: parent.height;
                                background: #242427; border-width: 1px; border-color: #303034;
                                Rectangle { y: 0px; width: parent.width; height: parent.height * 0.06; background: #8e7118; }
                                Rectangle { y: parent.height * 0.06; width: parent.width; height: parent.height * 0.14; background: #237d79; }
                                Rectangle { y: parent.height * (1 - root.microphone-meter / 100); width: parent.width; height: parent.height * root.microphone-meter / 100; background: Theme.teal; }
                            }
                            Text { x: 104px; y: parent.height * 0.03; text: "Peak"; color: Theme.text; font-size: 9px; }
                            Text { x: 104px; y: parent.height * 0.12; text: "Talk"; color: Theme.text; font-size: 9px; }
                        }
                        Text { height: 28px; text: "Output Gain"; color: Theme.quiet; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle {
                            height: 130px;
                            HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; }
                                VerticalFader { width: 38px; value: root.mic-output-gain-db / 12 * 100; accent: Theme.teal; muted: false; personal: true; show-mute: false; interactive: false; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        Text { height: 24px; text: round(root.mic-output-gain-db * 10) / 10 + "dB · READ ONLY"; color: Theme.amber; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle {
                            height: 30px; background: #242427; border-width: 1px; border-color: Theme.border;
                            Text { x: 5px; width: 78px; text: "10.0s / 10.0s"; color: Theme.text; font-size: 9px; vertical-alignment: center; }
                            Text { x: 86px; width: 24px; text: "●"; color: Theme.red; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            Text { x: 112px; width: 28px; text: "▶"; color: #48c65d; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }

            if root.active-page == 2: VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 32px; background: #1b1b1e; border-width: 1px; border-color: Theme.border;
                    Text { x: 10px; text: "BEACN STUDIO LIGHTING OPTIONS"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                    Text { x: parent.width - 206px; width: 196px; text: "PREVIEW ONLY · NO DEVICE WRITES"; color: Theme.amber; font-size: 8px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 388px; spacing: 0px;
                    Rectangle {
                        width: 200px; background: #232326; border-width: 1px; border-color: Theme.border;
                        Text { x: 10px; y: 10px; height: 22px; text: "Lighting Style"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        VerticalLayout {
                            x: 10px; y: 32px; width: parent.width - 10px; height: 96px; spacing: 0px;
                            LightingStyleRow { label: "Solid Colour"; selected: root.lighting-style == 0; clicked => { root.lighting-style = 0; } }
                            LightingStyleRow { label: "Peak Meter"; selected: root.lighting-style == 1; clicked => { root.lighting-style = 1; } }
                            LightingStyleRow { label: "Solid Spectrum"; selected: root.lighting-style == 2; clicked => { root.lighting-style = 2; } }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1; background: #252528; border-width: 1px; border-color: Theme.border;
                        Text { x: 16px; y: 10px; height: 18px; text: "Speed and Direction"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        Text { x: 24px; y: 31px; width: 28px; height: 18px; text: round(root.lighting-speed); color: Theme.teal; font-size: 10px; vertical-alignment: center; }
                        Slider { x: 55px; y: 27px; width: 243px; height: 22px; value: root.lighting-speed; minimum: -100; maximum: 100; changed(value) => { root.lighting-speed = value; } }
                        Text { x: 16px; y: 58px; height: 18px; text: "Ring Brightness"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        Text { x: 24px; y: 80px; width: 28px; height: 18px; text: round(root.lighting-brightness); color: Theme.teal; font-size: 10px; vertical-alignment: center; }
                        Slider { x: 55px; y: 76px; width: 243px; height: 22px; value: root.lighting-brightness; minimum: 0; maximum: 100; changed(value) => { root.lighting-brightness = value; } }
                    }
                }
                Rectangle { height: 32px; background: #1b1b1e; border-width: 1px; border-color: Theme.border; Text { x: 10px; text: "BEACN STUDIO OTHER LIGHTING OPTIONS"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; } }
                HorizontalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    Rectangle {
                        width: 351px; background: #252528; border-width: 1px; border-color: Theme.border;
                        Text { x: 10px; y: 10px; height: 20px; text: "When Muted"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        VerticalLayout {
                            x: 10px; y: 31px; width: 280px; height: 75px; spacing: 0px;
                            LightingRadioRow { label: "Do Nothing"; selected: root.lighting-muted-mode == 0; clicked => { root.lighting-muted-mode = 0; } }
                            LightingRadioRow { label: "Turn LED Ring to a Solid Colour"; selected: root.lighting-muted-mode == 1; clicked => { root.lighting-muted-mode = 1; } }
                            LightingRadioRow { label: "Turn Off LED Ring"; selected: root.lighting-muted-mode == 2; clicked => { root.lighting-muted-mode = 2; } }
                        }
                        Text { x: 10px; y: 113px; height: 20px; text: "Colour"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        Rectangle { x: 10px; y: 135px; width: 46px; height: 46px; border-radius: 10px; background: root.lighting-colour-index == 0 ? #f5000b : root.lighting-colour-index == 1 ? #ff3b00 : root.lighting-colour-index == 2 ? #ffe600 : root.lighting-colour-index == 3 ? #2ad83c : root.lighting-colour-index == 4 ? #00d5b7 : root.lighting-colour-index == 5 ? #16cde2 : root.lighting-colour-index == 6 ? #1474ed : root.lighting-colour-index == 7 ? #633ee8 : root.lighting-colour-index == 8 ? #9c1de1 : root.lighting-colour-index == 9 ? #e500c8 : root.lighting-colour-index == 10 ? #fa006e : #43b6aa; }
                        HorizontalLayout {
                            x: 59px; y: 135px; width: 239px; height: 22px; spacing: 2px;
                            LightingColourSwatch { swatch-colour: #f5000b; selected: root.lighting-colour-index == 0; clicked => { root.lighting-colour-index = 0; } }
                            LightingColourSwatch { swatch-colour: #ff3b00; selected: root.lighting-colour-index == 1; clicked => { root.lighting-colour-index = 1; } }
                            LightingColourSwatch { swatch-colour: #ffe600; selected: root.lighting-colour-index == 2; clicked => { root.lighting-colour-index = 2; } }
                            LightingColourSwatch { swatch-colour: #2ad83c; selected: root.lighting-colour-index == 3; clicked => { root.lighting-colour-index = 3; } }
                            LightingColourSwatch { swatch-colour: #00d5b7; selected: root.lighting-colour-index == 4; clicked => { root.lighting-colour-index = 4; } }
                            LightingColourSwatch { swatch-colour: #16cde2; selected: root.lighting-colour-index == 5; clicked => { root.lighting-colour-index = 5; } }
                            LightingColourSwatch { swatch-colour: #1474ed; selected: root.lighting-colour-index == 6; clicked => { root.lighting-colour-index = 6; } }
                            LightingColourSwatch { swatch-colour: #633ee8; selected: root.lighting-colour-index == 7; clicked => { root.lighting-colour-index = 7; } }
                            LightingColourSwatch { swatch-colour: #9c1de1; selected: root.lighting-colour-index == 8; clicked => { root.lighting-colour-index = 8; } }
                            LightingColourSwatch { swatch-colour: #e500c8; selected: root.lighting-colour-index == 9; clicked => { root.lighting-colour-index = 9; } }
                        }
                        HorizontalLayout {
                            x: 59px; y: 159px; width: 239px; height: 22px; spacing: 2px;
                            LightingColourSwatch { swatch-colour: #43b6aa; selected: root.lighting-colour-index == 11; clicked => { root.lighting-colour-index = 11; } }
                            LightingColourSwatch { swatch-colour: #62cb70; selected: root.lighting-colour-index == 12; clicked => { root.lighting-colour-index = 12; } }
                            LightingColourSwatch { swatch-colour: #5795cf; selected: root.lighting-colour-index == 13; clicked => { root.lighting-colour-index = 13; } }
                            LightingColourSwatch { swatch-colour: #7b67c5; selected: root.lighting-colour-index == 14; clicked => { root.lighting-colour-index = 14; } }
                            LightingColourSwatch { swatch-colour: #bd4368; selected: root.lighting-colour-index == 15; clicked => { root.lighting-colour-index = 15; } }
                            LightingColourSwatch { swatch-colour: #e2ba41; selected: root.lighting-colour-index == 16; clicked => { root.lighting-colour-index = 16; } }
                            LightingColourSwatch { swatch-colour: #d07d37; selected: root.lighting-colour-index == 17; clicked => { root.lighting-colour-index = 17; } }
                            LightingColourSwatch { swatch-colour: #c45c3f; selected: root.lighting-colour-index == 18; clicked => { root.lighting-colour-index = 18; } }
                            LightingColourSwatch { swatch-colour: #9aa0a0; selected: root.lighting-colour-index == 19; clicked => { root.lighting-colour-index = 19; } }
                            LightingColourSwatch { swatch-colour: #68808d; selected: root.lighting-colour-index == 20; clicked => { root.lighting-colour-index = 20; } }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1; background: #252528; border-width: 1px; border-color: Theme.border;
                        Text { x: 12px; y: 10px; height: 20px; text: "When USB Is Suspended"; color: Theme.text; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                        VerticalLayout {
                            x: 12px; y: 31px; width: 280px; height: 75px; spacing: 0px;
                            LightingRadioRow { label: "Do Nothing"; selected: root.lighting-suspended-mode == 0; clicked => { root.lighting-suspended-mode = 0; } }
                            LightingRadioRow { label: "Turn Off LED Ring"; selected: root.lighting-suspended-mode == 1; clicked => { root.lighting-suspended-mode = 1; } }
                            LightingRadioRow { label: "Change the Brightness to:"; selected: root.lighting-suspended-mode == 2; clicked => { root.lighting-suspended-mode = 2; } }
                        }
                        Slider { x: 44px; y: 114px; width: 277px; height: 22px; enabled: root.lighting-suspended-mode == 2; value: root.lighting-suspended-brightness; minimum: 0; maximum: 100; changed(value) => { root.lighting-suspended-brightness = value; } }
                        Text { x: 12px; y: parent.height - 22px; width: parent.width - 24px; height: 16px; text: "Local visual preview only — StudioBridge never sends lighting commands."; color: Theme.amber; font-size: 8px; vertical-alignment: center; }
                    }
                }
            }

            if root.active-page == 3: VerticalLayout {
                spacing: 0px;
                Rectangle { height: 42px; background: #1b1b1e; Text { x: 5px; text: "DEVICE SETTINGS"; color: Theme.text; font-size: 13px; font-weight: 800; vertical-alignment: center; } }
                Rectangle {
                    height: 305px; background: transparent;
                    Rectangle {
                        x: 13px; y: 10px; width: 755px; height: 285px;
                        background: #1f1f22; border-width: 1px; border-color: Theme.border;
                        Image { x: 68px; y: 28px; width: 70px; height: 70px; source: @image-url("../assets/studiobridge.svg"); }
                        Text { x: 158px; y: 42px; text: "Device Name:"; color: Theme.text; font-size: 13px; font-weight: 800; }
                        Text { x: 158px; y: 64px; text: root.device-name; color: Theme.quiet; font-size: 12px; font-weight: 700; }
                        Text { x: 110px; y: 124px; text: "Device Information"; color: Theme.text; font-size: 13px; font-weight: 800; }
                        Text { x: 110px; y: 150px; text: "Serial Number:"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                        Text { x: 285px; y: 150px; text: root.device-serial; color: Theme.text; font-size: 11px; font-weight: 700; }
                        Text { x: 110px; y: 169px; text: "Firmware Version:"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                        Text { x: 285px; y: 169px; text: root.device-firmware; color: Theme.text; font-size: 11px; font-weight: 700; }
                        Button {
                            x: 526px; y: 145px; width: 140px; height: 28px;
                            text: "Legal and Regulatory";
                            clicked => { root.legal-dialog-open = true; }
                        }
                        Text { x: 110px; y: 242px; text: "USB2 Driverless Mode"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                        ToggleSwitch { x: 614px; y: 239px; checked: root.driverless-mode; interactive: false; control-label: "USB2 Driverless Mode " + (root.driverless-mode ? "on" : "off") + ", read-only"; }
                        Text { x: 450px; y: 244px; text: (root.driverless-mode ? "ON" : "OFF") + " · read-only"; color: Theme.amber; font-size: 9px; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.active-page == 4: ScrollView {
                VerticalLayout {
                    x: 0px;
                    width: 684px;
                    padding-top: 34px;
                    padding-bottom: 34px;
                    padding-left: 44px;
                    padding-right: 34px;
                    spacing: 4px;
                    Text { text: "DEVICE POWER SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Boot StudioBridge on System Startup"; checked: root.start-at-login; toggled(value) => { root.start-at-login = value; root.save-preferences(value, root.open-to-system-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    SettingRow { label: "Open StudioBridge to System Tray"; checked: root.open-to-system-tray; toggled(value) => { root.open-to-system-tray = value; root.save-preferences(root.start-at-login, value, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE APP SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Show Save Confirmation Window"; checked: root.save-confirmation; toggled(value) => { root.save-confirmation = value; root.save-preferences(root.start-at-login, root.open-to-system-tray, value, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE BETA OPT-IN"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Opt-In to StudioBridge Public Beta Releases"; checked: root.beta-opt-in; toggled(value) => { root.beta-opt-in = value; root.save-preferences(root.start-at-login, root.open-to-system-tray, root.save-confirmation, value, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE MIXING SUITE"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "StudioBridge Mixing Suite Enabled"; checked: root.mixing-suite-enabled; toggled(value) => { root.mixing-suite-enabled = value; root.save-preferences(root.start-at-login, root.open-to-system-tray, root.save-confirmation, root.beta-opt-in, value, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "LINUX AUDIO SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Automatic Linux Default Device Reset"; checked: root.automatic-default-reset; toggled(value) => { root.automatic-default-reset = value; root.save-preferences(root.start-at-login, root.open-to-system-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, value, root.meter-crossfade); } }
                    Text { text: "MIXER SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Enable Crossfade on Profile Switching"; checked: root.meter-crossfade; toggled(value) => { root.meter-crossfade = value; root.save-preferences(root.start-at-login, root.open-to-system-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, value); } }
                    Text { text: "HOTKEY ASSIGNMENTS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    for hotkey in root.hotkeys: VerticalLayout {
                        spacing: 1px;
                        if hotkey.section != "": Text { height: 18px; text: hotkey.section; color: Theme.text; font-size: 10px; font-weight: 800; }
                        Rectangle {
                            height: 26px;
                            Text { x: 12px; width: 330px; text: hotkey.label; color: Theme.quiet; font-size: 10px; vertical-alignment: center; overflow: elide; }
                            Text { x: 350px; width: 210px; text: hotkey.binding == "" ? "+" : hotkey.binding; color: hotkey.binding == "" ? Theme.quiet : Theme.text; font-size: hotkey.binding == "" ? 18px : 9px; horizontal-alignment: right; vertical-alignment: center; }
                            TouchArea { clicked => { root.hotkey-editor-action = hotkey.action; root.hotkey-editor-label = hotkey.label; root.hotkey-editor-input = ""; root.hotkey-editor-key-label = ""; root.hotkey-editor-open = true; } }
                        }
                    }
                    Rectangle { height: 16px; }
                    HorizontalLayout { Button { text: "Refresh status"; clicked => { root.refresh(); } } StatusPill { label: root.daemon-connected ? "DAEMON CONNECTED" : "DAEMON DISCONNECTED"; good: root.daemon-connected; } StatusPill { label: root.hardware-safe ? "HARDWARE WRITES OFF" : "WRITES ACTIVE"; good: root.hardware-safe; } Rectangle { horizontal-stretch: 1; } }
                }
            }

            Rectangle {
                height: 24px;
                background: #171719;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.status-text; color: root.daemon-connected ? Theme.quiet : Theme.red; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } Text { text: root.hardware-safe ? "HARDWARE WRITES OFF" : "WRITES ACTIVE"; color: root.hardware-safe ? Theme.green : Theme.red; font-size: 9px; font-weight: 800; vertical-alignment: center; } Text { text: "  ·  StudioBridge"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; } }
            }
        }

            ProfileRail {
                connected: root.daemon-connected;
                hardware-safe: root.hardware-safe;
                link-active: root.link-active;
                mixer-profiles: root.mixer-profiles;
                studio-profiles-expanded: root.studio-profiles-expanded;
                mixer-profiles-expanded: root.mixer-profiles-expanded;
                expansion-changed(studio-expanded, mixer-expanded) => {
                    root.studio-profiles-expanded = studio-expanded;
                    root.mixer-profiles-expanded = mixer-expanded;
                    root.save-profile-expansion(studio-expanded, mixer-expanded);
                }
                create-profile => { root.create-mixer-profile(); }
                save-profile(name) => {
                    if root.save-confirmation {
                        root.pending-profile-save = name;
                        root.profile-save-confirm-open = true;
                    } else {
                        root.save-mixer-profile(name);
                    }
                }
                duplicate-profile(name) => { root.duplicate-mixer-profile(name); }
                select-profile(name) => { root.load-mixer-profile(name); }
                delete-profile(name) => { root.delete-mixer-profile(name); }
            }
        }
    }
    if !root.daemon-connected: Rectangle {
        z: 90;
        x: 72px;
        y: 28px;
        width: parent.width - 72px;
        height: parent.height - 52px;
        background: #121214d9;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 350px;
            height: 154px;
            border-radius: 7px;
            border-width: 1px;
            border-color: #44444a;
            background: #222225;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text { text: "STUDIOBRIDGE IS OFFLINE"; color: Theme.text; font-size: 13px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "The audio service is unavailable. Controls are paused to prevent stale changes."; color: Theme.quiet; font-size: 10px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.status-text; color: Theme.red; font-size: 9px; horizontal-alignment: center; overflow: elide; }
                HorizontalLayout {
                    alignment: center;
                    Button { text: "Retry connection"; clicked => { root.refresh(); } }
                }
            }
        }
    }
    if root.legal-dialog-open: Rectangle {
        z: 102;
        width: parent.width; height: parent.height; background: #00000099;
        TouchArea { width: parent.width; height: parent.height; }
        legal-panel := Rectangle {
            x: (parent.width - 784px) / 2; y: (parent.height - 289px) / 2;
            width: 784px; height: 289px;
            background: #282629; border-width: 1px; border-color: #48464a; border-radius: 5px;
            Rectangle {
                x: 0px; y: 0px; width: 784px; height: 28px;
                background: #18181a; border-width: 1px; border-color: #343438;
                Text { x: 0px; y: 0px; width: 784px; height: 28px; text: "Useful Information"; color: Theme.text; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                Text { x: 750px; y: 0px; width: 28px; height: 28px; text: "×"; color: Theme.teal; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { x: 744px; y: 0px; width: 40px; height: 28px; clicked => { root.legal-dialog-open = false; } }
            }
            Text {
                x: 12px; y: 66px; width: parent.width - 24px; height: 104px;
                text: "This device complies with part 15 of the FCC Rules. Operation is subject to the following two conditions: (1) This device may not cause harmful interference, and (2) this device must accept any interference received, including interference that may cause undesired operation.\nCAN ICES-3 (B)/NMB-3(B)";
                color: Theme.text; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            }
            Button {
                x: (parent.width - 260px) / 2; y: 221px; width: 260px; height: 40px; text: "OK";
                clicked => { root.legal-dialog-open = false; }
            }
        }
        legal-dialog-focus := FocusScope {
            z: 1;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Return {
                    root.legal-dialog-open = false;
                    return accept;
                }
                return accept;
            }
        }
    }
    if root.profile-save-confirm-open: Rectangle {
        z: 100;
        width: parent.width; height: parent.height; background: #00000099;
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.profile-save-confirm-open = false; root.pending-profile-save = ""; }
        }
        Rectangle {
            z: 1;
            x: (parent.width - 390px) / 2; y: (parent.height - 184px) / 2; width: 390px; height: 184px;
            background: #28282b; border-width: 1px; border-color: #4d4d51; border-radius: 5px;
            VerticalLayout {
                padding-top: 24px; padding-bottom: 18px; padding-left: 34px; padding-right: 34px; spacing: 11px;
                Text { text: "Save mixer profile?"; color: Theme.text; font-size: 15px; font-weight: 800; horizontal-alignment: center; }
                Text {
                    text: "Overwrite \"" + root.pending-profile-save + "\" with the current mixer state?";
                    color: Theme.text; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
                }
                Text {
                    text: "This updates its routing, volumes, assignments, and source order.";
                    color: Theme.quiet; font-size: 10px; horizontal-alignment: center; wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center; spacing: 14px;
                    Button {
                        width: 76px; text: "Save";
                        clicked => {
                            let name = root.pending-profile-save;
                            root.profile-save-confirm-open = false;
                            root.pending-profile-save = "";
                            root.save-mixer-profile(name);
                        }
                    }
                    Button { text: "Cancel"; clicked => { root.profile-save-confirm-open = false; root.pending-profile-save = ""; } }
                }
            }
        }
        save-confirm-focus := FocusScope {
            z: 2;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.profile-save-confirm-open = false;
                    root.pending-profile-save = "";
                    return accept;
                }
                if event.text == Key.Return {
                    let name = root.pending-profile-save;
                    root.profile-save-confirm-open = false;
                    root.pending-profile-save = "";
                    root.save-mixer-profile(name);
                    return accept;
                }
                return accept;
            }
        }
    }
    if root.hotkey-editor-open: Rectangle {
        z: 101;
        width: parent.width; height: parent.height; background: #00000099;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            z: 1;
            x: (parent.width - 350px) / 2; y: (parent.height - 176px) / 2; width: 350px; height: 176px;
            background: #28282b; border-width: 1px; border-color: #414145; border-radius: 7px;
            Text { x: 0px; y: 29px; width: parent.width; height: 22px; text: "New key-mapping"; color: Theme.text; font-size: 15px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            Text {
                x: 16px; y: 77px; width: parent.width - 32px; height: 22px;
                text: root.hotkey-editor-key-label == "" ? "Please press a key combination now..." : "Key: " + root.hotkey-editor-key-label;
                color: Theme.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
            }
            Button { x: 71px; y: 125px; width: 74px; height: 40px; text: "OK"; enabled: root.hotkey-editor-input != ""; clicked => { root.save-hotkey(root.hotkey-editor-action, root.hotkey-editor-input); root.hotkey-editor-open = false; } }
            Button { x: 163px; y: 125px; width: 115px; height: 40px; text: "Cancel"; clicked => { root.hotkey-editor-open = false; } }
        }
        hotkey-capture := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                let binding = root.normalize-hotkey(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                if binding != "" {
                    root.hotkey-editor-input = binding;
                    root.hotkey-editor-key-label = root.hotkey-key-label(event.text);
                }
                return accept;
            }
        }
    }
}

export component StudioBridgeTray inherits SystemTrayIcon {
    icon: @image-url("../assets/studiobridge.svg");
    title: "StudioBridge";
    tooltip: "StudioBridge · BEACN Studio control";
    callback show-app;
    callback show-safe-mode;
    callback quit-app;
    clicked => { root.show-app(); }
    Menu {
        MenuItem { title: "Open StudioBridge"; activated => { root.show-app(); } }
        MenuItem { title: "Open Microphone / Safe Mode"; activated => { root.show-safe-mode(); } }
        MenuSeparator { }
        MenuItem { title: "Quit StudioBridge"; activated => { root.quit-app(); } }
    }
}
