import { Button, Slider, ScrollView } from "std-widgets.slint";

export struct SourceModel {
    channel-id: string,
    meter-id: string,
    name: string,
    detail: string,
    colour: color,
    personal: float,
    audience: float,
    meter: float,
    linked: bool,
    personal-muted: bool,
    audience-muted: bool,
    mute-action: string,
}

export struct RouteModel {
    source-id: string,
    source-name: string,
    target-id: string,
    target-name: string,
    target-mix: string,
    colour: color,
    enabled: bool,
    row: int,
    column: int,
}

export struct ApplicationModel {
    process: string,
    name: string,
    title: string,
    channel-index: int,
}

export struct LinkApplicationModel {
    name: string,
    channel-index: int,
}

export struct TargetModel {
    target-id: string,
    meter-id: string,
    name: string,
    mix: string,
    volume: float,
    meter: float,
    muted: bool,
}

global Theme {
    in property <color> background: #19191b;
    in property <color> panel: #222225;
    in property <color> raised: #29292d;
    in property <color> border: #37373b;
    in property <color> text: #f0eff1;
    in property <color> quiet: #9a999f;
    in property <color> teal: #42c9c6;
    in property <color> amber: #d6aa55;
    in property <color> green: #69d195;
    in property <color> red: #e4665e;
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <bool> good;
    height: 26px;
    min-width: 104px;
    border-radius: 13px;
    border-width: 1px;
    border-color: good ? #397b59 : #77463f;
    background: good ? #152e22 : #301c1a;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: good ? Theme.green : Theme.red; }
        Text { text: root.label; color: good ? #bae8ca : #efb0aa; font-size: 10px; font-weight: 700; }
    }
}

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 58px;
    border-radius: 29px;
    background: active ? Theme.teal : #202023;
    border-width: 1px;
    border-color: active ? #78e5df : #29292d;
    if root.label == "MIXER": HorizontalLayout {
        x: 14px; y: 12px; width: 30px; height: 34px; spacing: 5px;
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 7px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 19px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 11px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
    }
    if root.label == "STUDIO": Rectangle {
        x: 13px; y: 17px; width: 32px; height: 24px; border-radius: 4px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 4px; y: -6px; width: 24px; height: 7px; border-radius: 3px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent; }
    }
    if root.label == "MIC": Rectangle {
        x: 14px; y: 10px; width: 30px; height: 30px; border-radius: 15px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 10px; y: 5px; width: 10px; height: 16px; border-radius: 5px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent; }
        Rectangle { x: 14px; y: 22px; width: 2px; height: 8px; background: root.active ? #ffffff : Theme.quiet; }
    }
    if root.label == "LIGHTING": Rectangle {
        x: 18px; y: 10px; width: 22px; height: 34px; border-radius: 4px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 5px; y: 5px; width: 12px; height: 12px; border-radius: 6px; background: root.active ? #ffffff : Theme.quiet; }
        Rectangle { x: 5px; y: 23px; width: 12px; height: 3px; background: root.active ? #ffffff : Theme.quiet; }
    }
    if root.label == "DEVICE" || root.label == "SETTINGS": Text { text: "⚙"; color: root.active ? #ffffff : Theme.quiet; font-size: 27px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component LevelMeter inherits Rectangle {
    in property <float> value;
    in property <color> colour: Theme.teal;
    width: 9px;
    background: #070b0c;
    border-width: 1px;
    border-color: #354146;
    border-radius: 2px;
    Rectangle {
        x: 2px;
        width: parent.width - 4px;
        y: parent.height * (1.0 - root.value / 100.0);
        height: parent.height * root.value / 100.0;
        background: root.colour;
        border-radius: 1px;
        animate y { duration: 65ms; easing: ease-out; }
        animate height { duration: 65ms; easing: ease-out; }
    }
}

export struct EqBandModel {
    band-index: int,
    x-percent: float,
    y-percent: float,
    colour: color,
    selected: bool,
    enabled: bool,
}

export struct ProfileModel {
    name: string,
    active: bool,
}

export struct HotkeyModel {
    section: string,
    label: string,
    action: string,
    binding: string,
}

component VerticalFader inherits Rectangle {
    in property <float> value;
    in property <color> accent: Theme.teal;
    in property <bool> muted;
    in property <bool> personal;
    in property <bool> show-mute: true;
    in property <bool> interactive: true;
    callback changed(float);
    callback mute-clicked;
    width: 34px;
    background: #171719;
    border-width: 1px;
    border-color: root.accent == Theme.teal ? Theme.teal : #111113;
    border-radius: 3px;
    Rectangle {
        x: (parent.width - 5px) / 2;
        y: 9px;
        width: 5px;
        height: parent.height - (root.show-mute ? 58px : 18px);
        background: #0d0d0f;
        border-radius: 2px;
    }
    Rectangle {
        x: 6px;
        y: 7px + (parent.height - (root.show-mute ? 64px : 24px)) * (1.0 - root.value / 100.0);
        width: parent.width - 12px;
        height: 7px;
        background: #e5e5e5;
        border-radius: 1px;
        animate y { duration: 55ms; easing: ease-out; }
    }
    Rectangle {
        visible: root.show-mute;
        x: 3px;
        y: parent.height - 42px;
        width: parent.width - 6px;
        height: 36px;
        background: root.muted ? #5d2528 : #202023;
        border-width: 1px;
        border-color: root.muted ? Theme.red : #34343a;
        border-radius: 4px;
        Text { text: root.personal ? "◉" : "((•))"; color: root.muted ? Theme.red : Theme.quiet; font-size: root.personal ? 19px : 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.mute-clicked(); } }
    }
    TouchArea {
        enabled: root.interactive;
        height: root.show-mute ? parent.height - 45px : parent.height;
        moved => {
            if (self.pressed) {
                root.changed(100.0 - self.mouse-y / self.height * 100.0);
            }
        }
        clicked => { root.changed(100.0 - self.mouse-y / self.height * 100.0); }
    }
}

component HorizontalFader inherits Rectangle {
    in property <float> value;
    callback changed(float);
    height: 20px;
    background: transparent;
    Rectangle { x: 0px; y: 8px; width: parent.width; height: 4px; background: #171719; border-radius: 2px; }
    Rectangle { x: 0px; y: 8px; width: parent.width * root.value / 100.0; height: 4px; background: Theme.teal; border-radius: 2px; }
    Rectangle {
        x: (parent.width - 10px) * root.value / 100.0;
        y: 3px;
        width: 10px;
        height: 14px;
        background: #dedee0;
        border-radius: 2px;
        animate x { duration: 55ms; easing: ease-out; }
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                let candidate = self.mouse-x / self.width * 100.0;
                root.changed(candidate <= 1.0 ? 0.0 : candidate >= 99.0 ? 100.0 : candidate);
            }
        }
        clicked => {
            let candidate = self.mouse-x / self.width * 100.0;
            root.changed(candidate <= 1.0 ? 0.0 : candidate >= 99.0 ? 100.0 : candidate);
        }
    }
}

component MixFader inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> meter;
    in property <bool> muted;
    in property <color> accent;
    callback changed(float);
    callback mute-clicked;
    background: transparent;
    VerticalLayout {
        spacing: 5px;
        Rectangle { height: 10px; background: transparent; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Rectangle { horizontal-stretch: 1; }
            LevelMeter { value: root.muted ? 0 : root.meter; colour: root.accent; }
            VerticalFader {
                value: root.value;
                accent: root.accent;
                muted: root.muted;
                personal: root.label == "PERSONAL";
                changed(value) => { root.changed(value); }
                mute-clicked => { root.mute-clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component MuteActionRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated;
    height: 20px;
    background: action-touch.has-hover ? #3a393e : transparent;
    action-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: button;
        accessible-label: root.label;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
        Text {
            x: 5px; width: 11px;
            text: root.selected ? "✓" : "";
            color: Theme.quiet; font-size: 9px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Text {
            x: 20px; width: parent.width - 24px;
            text: root.label;
            color: Theme.text; font-size: 9px; font-weight: 700;
            vertical-alignment: center;
        }
        action-touch := TouchArea { clicked => { action-focus.focus(); root.activated(); } }
    }
}

component SelectorMenuRow inherits Rectangle {
    in property <string> label;
    callback activated;
    height: 24px;
    background: row-touch.has-hover ? #3a393e : transparent;
    row-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: button;
        accessible-label: root.label;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
        Text {
            x: 20px; width: parent.width - 24px;
            text: root.label;
            color: Theme.text; font-size: 10px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
        row-touch := TouchArea { clicked => { row-focus.focus(); root.activated(); } }
    }
}

component BeacnSelector inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index: -1;
    in property <string> placeholder: "Choose Audio to output...";
    in property <length> popup-width: root.width;
    property <bool> current-valid: root.current-index >= 0 && root.current-index < root.model.length;
    property <int> option-count: root.model.length - (root.current-valid ? 1 : 0);
    callback selected(int);
    height: 27px;
    background: #1b1b1e;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        x: 7px; width: parent.width - 34px;
        text: root.current-index >= 0 && root.current-index < root.model.length
            ? root.model[root.current-index] : root.placeholder;
        color: root.current-index >= 0 ? Theme.text : Theme.quiet;
        font-size: 10px; font-weight: 700;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle { x: parent.width - 26px; width: 1px; height: parent.height; background: #303034; }
    Text { x: parent.width - 25px; width: 25px; text: "v"; color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
    selector-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: combobox;
        accessible-label: root.current-index >= 0 && root.current-index < root.model.length
            ? root.model[root.current-index] : root.placeholder;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                if selector-menu.is-open {
                    selector-menu.close();
                } else if root.option-count > 0 {
                    selector-menu.show();
                }
                return accept;
            }
            if event.text == Key.DownArrow && root.model.length > 0 {
                let next = root.current-index + 1 >= root.model.length ? 0 : root.current-index + 1;
                root.selected(next);
                return accept;
            }
            if event.text == Key.UpArrow && root.model.length > 0 {
                let next = root.current-index <= 0 ? root.model.length - 1 : root.current-index - 1;
                root.selected(next);
                return accept;
            }
            return reject;
        }
        TouchArea {
            clicked => {
                selector-focus.focus();
                if selector-menu.is-open {
                    selector-menu.close();
                } else if root.option-count > 0 {
                    selector-menu.show();
                }
            }
        }
    }
    selector-menu := PopupWindow {
        x: 0px; y: root.height; width: root.popup-width;
        height: root.option-count * 24px + 4px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width; height: parent.height;
            background: #27272b; border-width: 1px; border-color: #242326;
            VerticalLayout {
                padding: 2px; spacing: 0px;
                for item[index] in root.model: SelectorMenuRow {
                    visible: index != root.current-index;
                    label: item;
                    activated => { selector-menu.close(); root.selected(index); }
                }
            }
        }
    }
}

component SourceStrip inherits Rectangle {
    in property <SourceModel> source;
    in property <int> source-index;
    in-out property <bool> dragging: false;
    in-out property <length> drag-distance: 0px;
    in property <bool> application-dragging: false;
    in property <length> application-drag-x: 0px;
    in property <length> application-drag-y: 0px;
    property <bool> application-hovered: root.application-dragging
        && root.application-drag-x >= root.absolute-position.x
        && root.application-drag-x < root.absolute-position.x + root.width
        && root.application-drag-y >= root.absolute-position.y
        && root.application-drag-y < root.absolute-position.y + root.height;
    callback personal-changed(float);
    callback audience-changed(float);
    callback personal-mute;
    callback audience-mute;
    callback mute-action(string);
    callback mute-action-selected(string);
    callback reorder-requested(float);
    callback link-changed(bool);
    callback delete-source;
    width: 133px;
    height: 398px;
    border-radius: 2px;
    border-width: 1px;
    border-color: root.dragging || root.application-hovered ? Theme.teal : Theme.border;
    background: Theme.panel;
    opacity: root.dragging ? 0.82 : 1.0;
    VerticalLayout {
        padding: 7px;
        spacing: 5px;
        Rectangle {
            height: 18px;
            HorizontalLayout {
                spacing: 3px;
                grip-focus := FocusScope {
                    width: 14px;
                    accessible-role: button;
                    accessible-label: "Reorder " + root.source.name;
                    key-pressed(event) => {
                        if event.text == Key.LeftArrow {
                            root.reorder-requested(root.source-index - 1);
                            return accept;
                        } else if event.text == Key.RightArrow {
                            root.reorder-requested(root.source-index + 1);
                            return accept;
                        }
                        return reject;
                    }
                    Text { text: "⠿"; color: root.dragging ? Theme.teal : #5f5e64; font-size: 10px; vertical-alignment: center; }
                    drag-touch := TouchArea {
                        mouse-cursor: MouseCursor.grab;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                grip-focus.focus();
                                root.dragging = true;
                                root.drag-distance = 0px;
                            } else if event.kind == PointerEventKind.move && root.dragging {
                                root.drag-distance = self.mouse-x - self.pressed-x;
                            } else if event.kind == PointerEventKind.up && root.dragging {
                                root.drag-distance = self.mouse-x - self.pressed-x;
                                let delta = round(root.drag-distance / 137px);
                                root.dragging = false;
                                root.drag-distance = 0px;
                                if delta != 0 {
                                    root.reorder-requested(root.source-index + delta);
                                }
                            } else if event.kind == PointerEventKind.cancel {
                                root.dragging = false;
                                root.drag-distance = 0px;
                            }
                        }
                    }
                }
                Text { text: root.source.name; color: Theme.text; font-size: 13px; font-weight: 800; horizontal-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: "v"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
            }
            header-menu-focus := FocusScope {
                x: 17px; width: parent.width - 17px;
                accessible-role: button;
                accessible-label: "Open menu for " + root.source.name;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        if channel-menu.is-open { channel-menu.close(); } else { channel-menu.show(); }
                        return accept;
                    }
                    return reject;
                }
                TouchArea { clicked => { header-menu-focus.focus(); if channel-menu.is-open { channel-menu.close(); } else { channel-menu.show(); } } }
            }
        }
        Rectangle { height: 3px; background: root.source.colour; }
        HorizontalLayout {
            height: 219px;
            spacing: 3px;
            MixFader {
                label: "PERSONAL";
                value: root.source.personal;
                meter: root.source.meter;
                muted: root.source.personal-muted;
                accent: Theme.teal;
                changed(value) => { root.personal-changed(value); }
                mute-clicked => { root.personal-mute(); }
            }
            MixFader {
                label: "AUDIENCE";
                value: root.source.audience;
                meter: root.source.meter * root.source.audience / 100.0;
                muted: root.source.audience-muted;
                accent: Theme.amber;
                changed(value) => { root.audience-changed(value); }
                mute-clicked => { root.audience-mute(); }
            }
        }
        Rectangle {
            height: 18px;
            background: transparent;
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.source.linked ? Theme.teal : Theme.border;
                    background: root.source.linked ? #15302e : #101619;
                    Text { text: root.source.linked ? "∞" : "--"; color: root.source.linked ? Theme.teal : Theme.quiet; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.link-changed(!root.source.linked); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: 82px;
            background: #1a1a1d;
            border-width: 1px;
            border-color: #2d2d31;
            Text { x: 7px; y: 6px; width: parent.width - 14px; text: root.source.detail; color: Theme.quiet; font-size: 8px; overflow: elide; }
        }
        Rectangle {
            height: 20px;
            background: #202023;
            border-width: 1px;
            border-color: #303034;
            Text {
                width: parent.width - 20px;
                text: root.source.mute-action == "all" ? "Mute to All" : root.source.mute-action == "personal" ? "Mute to Self" : "Mute to Audience";
                color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 20px; width: 20px; height: parent.height;
                Rectangle { width: 1px; height: parent.height; background: #303034; }
                Text { text: "v"; color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                mute-menu-focus := FocusScope {
                    width: parent.width; height: parent.height;
                    accessible-role: button;
                    accessible-label: "Choose mute action for " + root.source.name;
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            if mute-menu.is-open { mute-menu.close(); } else { mute-menu.show(); }
                            return accept;
                        }
                        return reject;
                    }
                    TouchArea { clicked => { mute-menu-focus.focus(); if mute-menu.is-open { mute-menu.close(); } else { mute-menu.show(); } } }
                }
            }
            TouchArea { width: parent.width - 20px; clicked => { root.mute-action(root.source.mute-action); } }
        }
    }
    channel-menu := PopupWindow {
        x: 116px; y: 13px; width: 93px; height: 20px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width; height: parent.height;
            background: #49474d; border-width: 1px; border-color: #242326;
            delete-focus := FocusScope {
                width: parent.width; height: parent.height;
                accessible-role: button;
                accessible-label: "Delete " + root.source.name;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == Key.Space {
                        channel-menu.close();
                        root.delete-source();
                        return accept;
                    }
                    return reject;
                }
                Text { text: "Delete Knob"; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { channel-menu.close(); root.delete-source(); } }
            }
        }
    }
    mute-menu := PopupWindow {
        x: 116px; y: 326px; width: 112px; height: 60px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width; height: parent.height;
            background: #2d2d31; border-width: 1px; border-color: #242326;
            VerticalLayout {
                spacing: 0px;
                MuteActionRow {
                    label: "Mute to All"; selected: root.source.mute-action == "all";
                    activated => { mute-menu.close(); root.mute-action-selected("all"); }
                }
                MuteActionRow {
                    label: "Mute to Audience"; selected: root.source.mute-action == "audience";
                    activated => { mute-menu.close(); root.mute-action-selected("audience"); }
                }
                MuteActionRow {
                    label: "Mute to Self"; selected: root.source.mute-action == "personal";
                    activated => { mute-menu.close(); root.mute-action-selected("personal"); }
                }
            }
        }
    }
    Rectangle {
        visible: root.application-hovered;
        z: 29;
        width: parent.width; height: parent.height;
        border-width: 2px; border-color: Theme.teal; border-radius: 3px;
        background: #163b3977;
        Text { text: "DROP ON " + root.source.name.to-uppercase(); color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
}

component ContextTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <length> tab-width: 126px;
    callback clicked;
    width: root.tab-width;
    background: active ? #3a393e : transparent;
    Text { text: root.label; color: root.active ? Theme.teal : Theme.quiet; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.active ? Theme.teal : transparent; }
    context-tab-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: tab;
        accessible-label: root.label;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; } return reject; }
        TouchArea { clicked => { context-tab-focus.focus(); root.clicked(); } }
    }
}

component RoutingToggle inherits Rectangle {
    in property <RouteModel> route;
    callback toggled;
    width: 90px;
    height: 34px;
    background: transparent;
    cell := Rectangle {
        y: 5px; width: parent.width; height: 28px;
        background: #1c1c1f;
        border-width: 1px; border-color: #2e2e32;
        indicator := Rectangle {
            x: (parent.width - 18px) / 2; y: 5px; width: 18px; height: 18px;
            border-radius: 9px;
            border-width: 2px;
            border-color: root.route.enabled ? Theme.teal : Theme.red;
            background: root.route.enabled ? Theme.teal : transparent;
            if root.route.enabled: Path {
                width: parent.width; height: parent.height;
                commands: "M 4 9 L 8 13 L 14 5";
                fill: transparent; stroke: #17413f; stroke-width: 2px;
            }
            if !root.route.enabled: Path {
                width: parent.width; height: parent.height;
                commands: "M 4 14 L 14 4";
                fill: transparent; stroke: Theme.red; stroke-width: 2px;
            }
        }
    }
    route-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: checkbox;
        accessible-checked: root.route.enabled;
        accessible-label: (root.route.enabled ? "Exclude " : "Include ") + root.route.source-name + " in " + root.route.target-name;
        key-pressed(event) => { if event.text == Key.Return || event.text == Key.Space { root.toggled(); return accept; } return reject; }
        TouchArea { clicked => { route-focus.focus(); root.toggled(); } }
    }
}

component TargetStrip inherits Rectangle {
    in property <TargetModel> target;
    in property <[string]> output-device-names;
    in property <int> output-device-index: -1;
    callback volume-changed(float);
    callback output-device-selected(int);
    // BEACN keeps the default Personal/Audience device cards compact instead
    // of stretching them across the entire mixer canvas.
    width: root.target.mix == "Personal" ? 396px : 398px;
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.raised;
    if root.target.target-id == "headphones" || root.target.target-id == "audience-mix": VerticalLayout {
        padding-left: 7px; padding-right: 7px; padding-top: 4px; padding-bottom: 4px; spacing: 2px;
        Text {
            height: 14px;
            text: root.target.target-id == "headphones" ? "Personal Mix Device" : "Audience Mix Device";
            color: Theme.text; font-size: 10px; font-weight: 800;
        }
        HorizontalLayout {
            height: 34px;
            spacing: 7px;
            if root.target.target-id == "headphones": BeacnSelector {
                width: 170px;
                height: 27px;
                model: root.output-device-names;
                current-index: root.output-device-index;
                popup-width: 248px;
                selected(index) => { root.output-device-selected(index); }
            }
            if root.target.target-id == "audience-mix": Rectangle {
                width: 170px; height: 27px;
                background: #1b1b1e; border-width: 1px; border-color: Theme.border;
                Text { x: 7px; width: parent.width - 14px; text: root.target.name; color: Theme.teal; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            }
            LevelMeter { width: 8px; height: 24px; value: root.target.muted ? 0 : root.target.meter; colour: root.target.mix == "Personal" ? Theme.teal : Theme.amber; }
            HorizontalFader { horizontal-stretch: 1; value: root.target.volume; changed(value) => { root.volume-changed(value); } }
            Rectangle {
                width: 34px; height: 27px; border-radius: 3px;
                border-width: 1px; border-color: root.target.muted ? #6d3734 : Theme.border;
                background: root.target.muted ? #351b1a : #1b1b1e;
                Text { text: root.target.target-id == "headphones" ? "◉" : "((•))"; color: root.target.muted ? Theme.red : Theme.quiet; font-size: root.target.target-id == "headphones" ? 17px : 10px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    if root.target.target-id != "headphones" && root.target.target-id != "audience-mix": HorizontalLayout {
        padding: 7px; spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            Text { text: root.target.name; color: Theme.text; font-size: 12px; font-weight: 800; overflow: elide; }
            Text { text: root.target.mix + (root.target.muted ? " · MUTED" : " output"); color: root.target.muted ? Theme.red : Theme.quiet; font-size: 9px; }
            HorizontalFader { value: root.target.volume; changed(value) => { root.volume-changed(value); } }
        }
        LevelMeter { width: 12px; value: root.target.muted ? 0 : root.target.meter; colour: root.target.mix == "Personal" ? Theme.teal : Theme.amber; }
        Text { text: round(root.target.volume) + "%"; color: Theme.text; font-size: 10px; vertical-alignment: center; }
    }
}

