        text: root.preset;
        color: root.selected ? #ffffff : root.interactive ? Theme.text : #66666b;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    preset-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: button;
        accessible-label: "Bass Enhance style " + root.preset + (root.selected ? ", selected" : "");
        accessible-enabled: root.interactive;
        key-pressed(event) => {
            if root.interactive && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        TouchArea { enabled: root.interactive; clicked => { preset-focus.focus(); root.clicked(); } }
    }
}

component EnhancementDial inherits Rectangle {
    in property <string> label;
    in property <string> value-label;
    in property <string> dial-accessible-value: root.value-label;
    in property <string> control-label;
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <bool> enabled-state;
    in property <bool> interactive;
    callback changed(float);
    width: 82px;
    height: 88px;
    background: transparent;
    Rectangle {
        x: 10px;
        y: 1px;
        width: 62px;
        height: 62px;
        border-radius: 31px;
        background: #171719;
        border-width: 5px;
        border-color: root.enabled-state ? Theme.teal : #4a494f;
        Rectangle {
            x: 27px;
            y: 3px;
            width: 4px;
            height: 16px;
            background: root.enabled-state ? Theme.teal : Theme.quiet;
            border-radius: 2px;
        }
    }
    Text { x: 0px; y: 65px; width: parent.width; text: root.label; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
    Text { x: 0px; y: 78px; width: parent.width; text: root.value-label; color: root.enabled-state ? Theme.teal : Theme.quiet; font-size: 8px; horizontal-alignment: center; }
    dial-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: button;
        accessible-label: root.control-label + " " + root.dial-accessible-value;
        accessible-enabled: root.interactive;
        key-pressed(event) => {
            if root.interactive && (event.text == Key.UpArrow || event.text == Key.RightArrow) {
                root.changed(root.value + root.step > root.maximum ? root.maximum : root.value + root.step);
                return accept;
            }
            if root.interactive && (event.text == Key.DownArrow || event.text == Key.LeftArrow) {
                root.changed(root.value - root.step < root.minimum ? root.minimum : root.value - root.step);
                return accept;
            }
            return reject;
        }
        TouchArea {
            enabled: root.interactive;
            moved => {
                if (self.pressed) {
                    let candidate = root.maximum - self.mouse-y / self.height * (root.maximum - root.minimum);
                    root.changed(candidate < root.minimum ? root.minimum : candidate > root.maximum ? root.maximum : candidate);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    dial-focus.focus();
                }
            }
        }
    }
}

