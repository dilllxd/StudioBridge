import { Button, ComboBox, Slider, ScrollView } from "std-widgets.slint";

export struct SourceModel {
    channel-id: string,
    meter-id: string,
    name: string,
    detail: string,
    colour: color,
    personal: float,
    audience: float,
    meter: float,
    linked: bool,
    muted: bool,
}

export struct RouteModel {
    source-id: string,
    source-name: string,
    target-id: string,
    target-name: string,
    target-mix: string,
    colour: color,
    enabled: bool,
}

export struct ApplicationModel {
    process: string,
    name: string,
    title: string,
    channel-index: int,
}

export struct LinkApplicationModel {
    name: string,
    channel-index: int,
}

global Theme {
    in property <color> background: #0d1214;
    in property <color> panel: #151d21;
    in property <color> raised: #1b252a;
    in property <color> border: #334047;
    in property <color> text: #eeeae2;
    in property <color> quiet: #899399;
    in property <color> teal: #58d5cb;
    in property <color> amber: #f0b55c;
    in property <color> green: #6bd596;
    in property <color> red: #e66d62;
}

component NavTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: 132px;
    background: active ? #1b292d : transparent;
    border-width: active ? 0px : 0px;

    Text {
        text: root.label;
        color: root.active ? Theme.teal : Theme.quiet;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: root.active ? Theme.teal : transparent;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <bool> good;
    height: 28px;
    min-width: 110px;
    border-radius: 14px;
    border-width: 1px;
    border-color: good ? #397c5a : #754942;
    background: good ? #173326 : #321d1b;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: good ? Theme.green : Theme.red; }
        Text { text: root.label; color: good ? #bce9cd : #f0b4ad; font-size: 11px; font-weight: 700; }
    }
}

component Meter inherits Rectangle {
    in property <float> value;
    in property <color> colour: Theme.teal;
    width: 10px;
    border-radius: 2px;
    background: #0a0f11;
    border-width: 1px;
    border-color: #3a464b;
    Rectangle {
        x: 2px;
        width: parent.width - 4px;
        y: parent.height * (1.0 - root.value / 100.0);
        height: parent.height * root.value / 100.0;
        background: root.colour;
        border-radius: 1px;
        animate y { duration: 65ms; easing: ease-out; }
        animate height { duration: 65ms; easing: ease-out; }
    }
}

component SourceStrip inherits Rectangle {
    in property <SourceModel> source;
    callback personal-changed(float);
    callback audience-changed(float);
    width: 154px;
    min-height: 560px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 4px;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: root.source.colour;
        }
        Text { text: root.source.name; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
        Text { text: root.source.detail; color: Theme.quiet; font-size: 10px; horizontal-alignment: center; overflow: elide; }
        HorizontalLayout {
            spacing: 9px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                Text { text: "YOU"; color: Theme.teal; font-size: 10px; horizontal-alignment: center; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Meter { value: root.source.meter; colour: Theme.teal; }
                    Slider { value: root.source.personal; minimum: 0; maximum: 100; orientation: vertical; changed(value) => { root.personal-changed(value); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: round(root.source.personal) + "%"; color: Theme.text; font-size: 12px; horizontal-alignment: center; }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "STREAM"; color: Theme.amber; font-size: 10px; horizontal-alignment: center; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Meter { value: root.source.meter * root.source.audience / 100.0; colour: Theme.amber; }
                    Slider { value: root.source.audience; minimum: 0; maximum: 100; orientation: vertical; changed(value) => { root.audience-changed(value); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: round(root.source.audience) + "%"; color: Theme.text; font-size: 12px; horizontal-alignment: center; }
            }
        }
        Rectangle {
            height: 32px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.source.linked ? Theme.teal : Theme.border;
            background: root.source.linked ? #17302f : #111719;
            Text { text: root.source.linked ? "LEVELS LINKED" : "LEVELS INDEPENDENT"; color: root.source.linked ? Theme.teal : Theme.quiet; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle {
            height: 38px;
            border-radius: 3px;
            background: root.source.muted ? #7d2d29 : #202a2f;
            border-width: 1px;
            border-color: root.source.muted ? Theme.red : #46535a;
            Text { text: root.source.muted ? "MUTED" : "MUTE"; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

component ProcessingCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <bool> enabled: true;
    min-height: 150px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding: 16px;
        spacing: 9px;
        HorizontalLayout {
            Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-stretch: 1; }
            Text { text: root.enabled ? "ACTIVE" : "BYPASSED"; color: root.enabled ? Theme.green : Theme.quiet; font-size: 10px; font-weight: 700; }
        }
        Text { text: root.subtitle; color: Theme.quiet; font-size: 11px; }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: root.value; color: Theme.teal; font-size: 26px; font-weight: 700; }
    }
}

component ModuleButton inherits Rectangle {
    in property <string> label;
    in property <string> module;
    in property <string> selected;
    callback clicked(string);
    height: 34px;
    border-radius: 3px;
    background: root.module == root.selected ? #17302f : transparent;
    border-width: root.module == root.selected ? 1px : 0px;
    border-color: Theme.teal;
    Text {
        text: root.label;
        color: root.module == root.selected ? Theme.teal : Theme.quiet;
        font-size: 11px;
        font-weight: root.module == root.selected ? 700 : 500;
        vertical-alignment: center;
        x: 9px;
    }
    TouchArea { clicked => { root.clicked(root.module); } }
}

export component MainWindow inherits Window {
    title: "StudioBridge";
    icon: @image-url("../assets/studiobridge.svg");
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 620px;
    background: Theme.background;

    in property <[SourceModel]> sources;
    in property <[RouteModel]> routes;
    in property <[ApplicationModel]> linux-applications;
    in property <[LinkApplicationModel]> link-applications;
    in property <[string]> mixer-channel-names;
    in property <[string]> link-channel-names;
    in-out property <int> active-page: 0;
    in property <bool> daemon-connected: false;
    in property <bool> hardware-safe: true;
    in property <bool> link-active: false;
    in property <int> dsp-gate-count: 0;
    in-out property <string> dsp-selected-module: "headphone_equalizer";
    in property <string> dsp-active-module: "";
    in property <int> dsp-lease-seconds: 0;
    in-out property <bool> arm-confirm-pending: false;
    in property <string> dsp-editor-title: "HEADPHONE EQUALIZER";
    in property <string> dsp-label-a: "Bass dB";
    in property <string> dsp-label-b: "Mids dB";
    in property <string> dsp-label-c: "Treble dB";
    in-out property <float> dsp-value-a: 0;
    in-out property <float> dsp-value-b: 0;
    in-out property <float> dsp-value-c: 0;
    in property <float> dsp-min-a: -12;
    in property <float> dsp-max-a: 12;
    in property <float> dsp-min-b: -12;
    in property <float> dsp-max-b: 12;
    in property <float> dsp-min-c: -12;
    in property <float> dsp-max-c: 12;
    in property <string> status-text: "Connecting to StudioBridge daemon";
    callback refresh;
    callback set-volume(string, string, float);
    callback select-dsp-module(string);
    callback load-dsp;
    callback arm-dsp;
    callback disarm-dsp;
    callback apply-dsp(float, float, float);
    callback revert-dsp;
    callback set-route(string, string, bool);
    callback assign-linux-application(string, string, int);
    callback assign-link-application(string, int);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 62px;
            background: #0b1012;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 16px;
                spacing: 0px;
                HorizontalLayout {
                    width: 220px;
                    spacing: 10px;
                    Image { source: @image-url("../assets/studiobridge.svg"); width: 34px; height: 34px; }
                    Text { text: "STUDIOBRIDGE"; color: Theme.text; font-size: 20px; font-weight: 800; }
                }
                NavTab { label: "MIXER"; active: root.active-page == 0; clicked => { root.active-page = 0; } }
                NavTab { label: "ROUTING"; active: root.active-page == 1; clicked => { root.active-page = 1; } }
                NavTab { label: "APPLICATIONS"; active: root.active-page == 2; clicked => { root.active-page = 2; } }
                NavTab { label: "MIC CHAIN"; active: root.active-page == 3; clicked => { root.active-page = 3; } }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    StatusPill { label: root.daemon-connected ? "STUDIO CONNECTED" : "DISCONNECTED"; good: root.daemon-connected; }
                    StatusPill { label: root.hardware-safe ? "HARDWARE SAFE" : "WRITES ACTIVE"; good: root.hardware-safe; }
                }
            }
        }

        if root.active-page == 0: Rectangle {
            background: Theme.background;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                ScrollView {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        for source in root.sources: SourceStrip {
                            source: source;
                            personal-changed(value) => { root.set-volume(source.channel-id, "personal", value); }
                            audience-changed(value) => { root.set-volume(source.channel-id, "audience", value); }
                        }
                    }
                }
                Rectangle {
                    width: 220px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        Text { text: "MAIN OUT"; color: Theme.amber; font-size: 15px; font-weight: 800; }
                        Text { text: "Personal listening"; color: Theme.quiet; font-size: 11px; }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            Rectangle { horizontal-stretch: 1; }
                            Meter { width: 18px; value: 48; colour: Theme.teal; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: "HEADPHONES"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "100%"; color: Theme.teal; font-size: 24px; font-weight: 700; horizontal-alignment: center; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Text { text: "Audience mix  ·  100%"; color: Theme.amber; font-size: 12px; horizontal-alignment: center; }
                    }
                }
            }
        }

        if root.active-page == 1: Rectangle {
            background: Theme.background;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "SIGNAL ROUTING"; color: Theme.text; font-size: 25px; font-weight: 800; }
                Text { text: "Choose exactly where each source is heard. These are PipeWeaver software routes; Personal and Audience levels remain independent."; color: Theme.quiet; font-size: 12px; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for route in root.routes: Rectangle {
                            height: 58px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: route.enabled ? Theme.teal : Theme.border;
                            background: route.enabled ? #142b2b : Theme.panel;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 12px;
                                Rectangle { width: 5px; height: 32px; border-radius: 2px; background: route.colour; }
                                Text { text: route.source-name; color: Theme.text; font-size: 15px; font-weight: 700; width: 210px; vertical-alignment: center; }
                                Text { text: "→"; color: Theme.quiet; font-size: 18px; vertical-alignment: center; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: route.target-name; color: route.enabled ? Theme.teal : Theme.text; font-size: 14px; font-weight: 700; }
                                    Text { text: route.target-mix + " output"; color: Theme.quiet; font-size: 10px; }
                                }
                                Button { text: route.enabled ? "Connected" : "Connect"; clicked => { root.set-route(route.source-id, route.target-id, !route.enabled); } }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 2: Rectangle {
            background: Theme.background;
            HorizontalLayout {
                padding: 20px;
                spacing: 14px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "WINDOWS APPS"; color: Theme.text; font-size: 21px; font-weight: 800; }
                        Text { text: "BEACN Link · Gaming PC · multiple apps per Link channel"; color: Theme.quiet; font-size: 11px; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 7px;
                                for app in root.link-applications: Rectangle {
                                    height: 62px;
                                    background: Theme.raised;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        Text { text: app.name; color: Theme.text; font-size: 13px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        ComboBox {
                                            width: 150px;
                                            model: root.link-channel-names;
                                            current-index: app.channel-index;
                                            selected(value) => { root.assign-link-application(app.name, self.current-index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: "LINUX APPS"; color: Theme.text; font-size: 21px; font-weight: 800; }
                        Text { text: "PipeWire · Streaming PC · persistent PipeWeaver assignment"; color: Theme.quiet; font-size: 11px; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 7px;
                                for app in root.linux-applications: Rectangle {
                                    height: 62px;
                                    background: Theme.raised;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            Text { text: app.title; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; }
                                            Text { text: app.process; color: Theme.quiet; font-size: 9px; overflow: elide; }
                                        }
                                        ComboBox {
                                            width: 175px;
                                            model: root.mixer-channel-names;
                                            current-index: app.channel-index;
                                            selected(value) => { root.assign-linux-application(app.process, app.name, self.current-index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 3: Rectangle {
            background: Theme.background;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Rectangle {
                    width: 190px;
                    background: #10171a;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        Text { text: "BEACN STUDIO"; color: Theme.text; font-size: 17px; font-weight: 800; }
                        Text { text: "USB1  ·  ONBOARD DSP"; color: Theme.quiet; font-size: 9px; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Text { text: "PROCESSING"; color: Theme.teal; font-size: 10px; font-weight: 700; }
                        ModuleButton { label: "NOISE SUPPRESSION"; module: "noise_suppression"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleButton { label: "EQUALIZER"; module: "equalizer"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleButton { label: "COMPRESSOR"; module: "compressor"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleButton { label: "EXPANDER / GATE"; module: "expander"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleButton { label: "ENHANCEMENT SUITE"; module: "enhancement_suite"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleButton { label: "HEADPHONE EQ"; module: "headphone_equalizer"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        Rectangle { vertical-stretch: 1; }
                        StatusPill { label: root.dsp-gate-count == 0 ? "DSP DISARMED" : root.dsp-gate-count + " MODULE ARMED"; good: root.dsp-gate-count == 0; }
                    }
                }
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            ProcessingCard { title: "MIC INPUT"; subtitle: "Phantom power is never changed automatically"; value: "41 dB"; horizontal-stretch: 1; }
                            ProcessingCard { title: "LIVE LEVEL"; subtitle: "Target speaking range: −25 to −10 dB"; value: "READY"; horizontal-stretch: 1; }
                        }
                        Rectangle {
                            min-height: 350px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.panel;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                HorizontalLayout {
                                    Text { text: root.dsp-editor-title; color: Theme.text; font-size: 22px; font-weight: 800; horizontal-stretch: 1; }
                                    StatusPill {
                                        label: root.dsp-active-module == root.dsp-selected-module ? "EDITING  " + root.dsp-lease-seconds + "s" : "READ ONLY";
                                        good: root.dsp-active-module == root.dsp-selected-module;
                                    }
                                }
                                Text { text: "Changes are staged locally. Apply writes one validated module, reads the entire chain back, and reports success only after verification."; color: Theme.quiet; font-size: 11px; }
                                VerticalLayout {
                                    spacing: 7px;
                                    Text { text: root.dsp-label-a + "   " + round(root.dsp-value-a * 10) / 10; color: Theme.text; font-size: 12px; }
                                    Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                    Text { text: root.dsp-label-b + "   " + round(root.dsp-value-b * 10) / 10; color: Theme.text; font-size: 12px; }
                                    Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                                    Text { text: root.dsp-label-c + "   " + round(root.dsp-value-c * 10) / 10; color: Theme.text; font-size: 12px; }
                                    Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; changed(value) => { root.dsp-value-c = value; } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Reload read-back"; clicked => { root.load-dsp(); } }
                                    if root.dsp-active-module == root.dsp-selected-module: Button { text: "Apply + verify"; clicked => { root.apply-dsp(root.dsp-value-a, root.dsp-value-b, root.dsp-value-c); } }
                                    if root.dsp-active-module == root.dsp-selected-module: Button { text: "Revert captured"; clicked => { root.revert-dsp(); } }
                                    if root.dsp-active-module != root.dsp-selected-module && !root.arm-confirm-pending: Button { text: "Enable editing for 5 minutes"; clicked => { root.arm-confirm-pending = true; } }
                                    if root.dsp-active-module != root.dsp-selected-module && root.arm-confirm-pending: Button { text: "Confirm: this changes audio"; clicked => { root.arm-dsp(); } }
                                    if root.arm-confirm-pending: Button { text: "Cancel"; clicked => { root.arm-confirm-pending = false; } }
                                    if root.dsp-active-module != "": Button { text: "Disarm now"; clicked => { root.disarm-dsp(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { text: "General hardware writes remain OFF. Phantom power, firmware, factory reset, lighting, limiter guesses, and storage are outside this editor."; color: Theme.amber; font-size: 10px; }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 34px;
            background: #0b1012;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text { text: root.status-text; color: root.daemon-connected ? Theme.quiet : Theme.red; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: root.link-active ? "LINK CONTROL ACTIVE" : "LINK CONTROL OFF"; color: root.link-active ? Theme.green : Theme.quiet; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                Button { text: "Refresh"; clicked => { root.refresh(); } }
            }
        }
    }
}

export component StudioBridgeTray inherits SystemTrayIcon {
    icon: @image-url("../assets/studiobridge.svg");
    title: "StudioBridge";
    tooltip: "StudioBridge · BEACN Studio control";
    callback show-app;
    callback show-safe-mode;
    callback quit-app;
    clicked => { root.show-app(); }
    Menu {
        MenuItem { title: "Open StudioBridge"; activated => { root.show-app(); } }
        MenuItem { title: "Open Mic Chain / Safe Mode"; activated => { root.show-safe-mode(); } }
        MenuSeparator { }
        MenuItem { title: "Quit StudioBridge"; activated => { root.quit-app(); } }
    }
}
