                                Dial { label: "BASS"; value-label: round(root.dsp-value-a * 10) / 10 + ""; active: root.dsp-active-module == root.dsp-selected-module; }
                                Dial { label: "DE-ESSER"; value-label: round(root.dsp-value-b * 10) / 10 + "%"; active: root.dsp-active-module == root.dsp-selected-module; }
                                Dial { label: "EXCITER"; value-label: round(root.dsp-value-c * 10) / 10 + "%"; active: root.dsp-active-module == root.dsp-selected-module; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        if root.dsp-selected-module == "noise_suppression": HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                width: 250px; spacing: 7px;
                                HorizontalLayout { Text { text: "Noise Suppression"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-stretch: 1; } ToggleSwitch { checked: true; interactive: false; } }
                                HorizontalLayout {
                                    height: 28px; spacing: 2px;
                                    Rectangle { horizontal-stretch: 1; background: !root.noise-snapshot ? Theme.teal : #27272b; Text { text: "ADAPTIVE"; color: Theme.text; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.noise-snapshot = false; } } }
                                    Rectangle { horizontal-stretch: 1; background: root.noise-snapshot ? Theme.teal : #27272b; Text { text: "SNAPSHOT"; color: Theme.text; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.noise-snapshot = true; } } }
                                }
                                Text { text: "AMOUNT   " + round(root.dsp-value-a * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                Text { text: "SENSITIVITY   " + round(root.dsp-value-b * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                            }
                            Rectangle {
