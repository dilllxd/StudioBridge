                                Rectangle { x: 0px; y: parent.height * 0.66; width: parent.width; height: 1px; background: #343a3d; }
                                Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #242a2d; }
                                Path { width: parent.width; height: parent.height; commands: "M 0 45 C 90 48 145 62 225 82 C 315 106 410 115 510 116 C 630 117 760 119 900 119"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Text { x: 8px; y: 8px; text: root.noise-snapshot ? "Captured noise profile" : "Adaptive noise floor"; color: Theme.quiet; font-size: 9px; }
                            }
                        }

                        if root.dsp-selected-module == "expander": HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                width: 285px; spacing: 6px;
                                Text { text: "THRESHOLD   " + round(root.dsp-value-a * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                HorizontalLayout { height: 26px; Text { text: "SIMPLE"; color: !root.dsp-advanced ? Theme.teal : Theme.quiet; font-size: 9px; font-weight: 800; } ToggleSwitch { checked: root.dsp-advanced; toggled(value) => { root.dsp-advanced = value; } } Text { text: "ADVANCED"; color: root.dsp-advanced ? Theme.teal : Theme.quiet; font-size: 9px; font-weight: 800; } }
                                Text { text: root.dsp-advanced ? "RATIO   " + round(root.dsp-value-b * 10) / 10 : "EXPAND AMOUNT   " + round(root.dsp-value-b * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                                if root.dsp-advanced: Text { text: "ATTACK / RELEASE   " + round(root.dsp-value-c * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                if root.dsp-advanced: Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; changed(value) => { root.dsp-value-c = value; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #111518; border-width: 1px; border-color: Theme.border;
                                Rectangle { x: 0px; y: parent.height * 0.75; width: parent.width; height: 1px; background: #343a3d; }
                                Path { width: parent.width; height: parent.height; commands: "M 0 142 L 215 142 C 280 142 310 118 360 92 L 520 10 L 900 10"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Text { x: 10px; y: 10px; text: root.dsp-advanced ? "Advanced expander curve" : "Simple expander curve"; color: Theme.quiet; font-size: 9px; }
                            }
                        }

                        if root.dsp-selected-module == "compressor": HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                width: 285px; spacing: 6px;
                                Text { text: "THRESHOLD   " + round(root.dsp-value-a * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                HorizontalLayout { height: 26px; Text { text: "SIMPLE"; color: !root.dsp-advanced ? Theme.teal : Theme.quiet; font-size: 9px; font-weight: 800; } ToggleSwitch { checked: root.dsp-advanced; toggled(value) => { root.dsp-advanced = value; } } Text { text: "ADVANCED"; color: root.dsp-advanced ? Theme.teal : Theme.quiet; font-size: 9px; font-weight: 800; } }
                                Text { text: root.dsp-advanced ? "RATIO / ATTACK / RELEASE" : "COMPRESS AMOUNT   " + round(root.dsp-value-b * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                                Text { text: "MAKEUP GAIN   " + round(root.dsp-value-c * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; changed(value) => { root.dsp-value-c = value; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #111518; border-width: 1px; border-color: Theme.border;
                                Path { width: parent.width; height: parent.height; commands: "M 0 142 L 300 75 C 350 64 410 60 900 58"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                HorizontalLayout { x: 18px; y: 12px; width: parent.width - 36px; height: 24px; spacing: 8px; Text { text: "INPUT"; color: Theme.quiet; font-size: 8px; } Rectangle { horizontal-stretch: 1; background: #23282b; Rectangle { width: parent.width * 0.55; height: parent.height; background: Theme.teal; } } Text { text: "ATTENUATION"; color: Theme.quiet; font-size: 8px; } Rectangle { horizontal-stretch: 1; background: #23282b; Rectangle { width: parent.width * 0.22; height: parent.height; background: Theme.amber; } } Text { text: "OUTPUT"; color: Theme.quiet; font-size: 8px; } Rectangle { horizontal-stretch: 1; background: #23282b; Rectangle { width: parent.width * 0.48; height: parent.height; background: Theme.teal; } } }
                            }
                        }

                        if root.dsp-selected-module == "headphone_equalizer": HorizontalLayout {
                            spacing: 18px;
                            VerticalLayout { width: 110px; Text { text: "MIC MONITOR"; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-alignment: center; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: 42; accent: Theme.teal; muted: false; personal: true; show-mute: false; } Rectangle { horizontal-stretch: 1; } } }
                            VerticalLayout { width: 110px; Text { text: "HEADPHONES"; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-alignment: center; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: 66; accent: Theme.teal; muted: false; personal: true; show-mute: false; } Rectangle { horizontal-stretch: 1; } } }
                            Dial { label: "BASS"; value-label: round(root.dsp-value-a * 10) / 10 + "dB"; }
                            Dial { label: "MIDS"; value-label: round(root.dsp-value-b * 10) / 10 + "dB"; }
                            Dial { label: "TREBLE"; value-label: round(root.dsp-value-c * 10) / 10 + "dB"; }
                            VerticalLayout { horizontal-stretch: 1; Text { text: "SUBWOOFER"; color: Theme.text; font-size: 10px; font-weight: 800; } Slider { value: 45; } Text { text: "AMP POWER"; color: Theme.text; font-size: 10px; font-weight: 800; } Text { text: "○ Low     ● Medium     ○ High"; color: Theme.quiet; font-size: 10px; } }
                        }

                        HorizontalLayout {
                            spacing: 7px;
                            Button { text: "Reload read-back"; clicked => { root.load-dsp(); } }
                            if root.dsp-active-module == root.dsp-selected-module: Button { text: "Apply + verify"; clicked => { root.apply-dsp(root.dsp-value-a, root.dsp-value-b, root.dsp-value-c); } }
                            if root.dsp-active-module == root.dsp-selected-module: Button { text: "Revert captured"; clicked => { root.revert-dsp(); } }
                            if root.dsp-active-module != root.dsp-selected-module && !root.arm-confirm-pending: Button { text: "Enable editing for 5 minutes"; clicked => { root.arm-confirm-pending = true; } }
                            if root.dsp-active-module != root.dsp-selected-module && root.arm-confirm-pending: Button { text: "Confirm: this changes audio"; clicked => { root.arm-dsp(); } }
                            if root.arm-confirm-pending: Button { text: "Cancel"; clicked => { root.arm-confirm-pending = false; } }
                            if root.dsp-active-module != "": Button { text: "Disarm now"; clicked => { root.disarm-dsp(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: "General hardware writes remain OFF. Phantom power, firmware, reset, lighting, limiter guesses, and storage are excluded."; color: Theme.amber; font-size: 9px; }
                    }
                }
            }

            if root.active-page == 2: VerticalLayout {
                spacing: 0px;
                Rectangle { height: 32px; background: #1b1b1e; Text { x: 10px; text: "BEACN STUDIO LIGHTING OPTIONS"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; } }
                HorizontalLayout {
                    height: 365px;
                    Rectangle {
                        width: 200px;
                        background: #232326;
                        border-width: 1px; border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px; spacing: 4px;
                            Text { text: "Lighting Style"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Rectangle { height: 34px; background: root.lighting-style == 0 ? #3a393e : transparent; Text { x: 10px; text: "Solid Colour"; color: root.lighting-style == 0 ? Theme.text : Theme.quiet; font-size: 11px; font-weight: root.lighting-style == 0 ? 700 : 400; vertical-alignment: center; } TouchArea { clicked => { root.lighting-style = 0; } } }
                            Rectangle { height: 34px; background: root.lighting-style == 1 ? #3a393e : transparent; Text { x: 10px; text: "Peak Meter"; color: root.lighting-style == 1 ? Theme.text : Theme.quiet; font-size: 11px; font-weight: root.lighting-style == 1 ? 700 : 400; vertical-alignment: center; } TouchArea { clicked => { root.lighting-style = 1; } } }
                            Rectangle { height: 34px; background: root.lighting-style == 2 ? #3a393e : transparent; Text { x: 10px; text: "Solid Spectrum"; color: root.lighting-style == 2 ? Theme.text : Theme.quiet; font-size: 11px; font-weight: root.lighting-style == 2 ? 700 : 400; vertical-alignment: center; } TouchArea { clicked => { root.lighting-style = 2; } } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        width: 250px;
                        background: #252528;
                        border-width: 1px; border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px; spacing: 8px;
                            Text { text: "Speed and Direction"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: round(root.lighting-speed); color: Theme.teal; font-size: 11px; }
                            Slider { value: root.lighting-speed; minimum: -100; maximum: 100; changed(value) => { root.lighting-speed = value; } }
                            Text { text: "Ring Brightness"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: round(root.lighting-brightness); color: Theme.teal; font-size: 11px; }
                            Slider { value: root.lighting-brightness; minimum: 0; maximum: 100; changed(value) => { root.lighting-brightness = value; } }
                            Rectangle {
                                vertical-stretch: 1; background: #141417; border-width: 1px; border-color: Theme.border;
                                Rectangle { x: parent.width * 0.18; y: parent.height * 0.18; width: parent.height * 0.58; height: parent.height * 0.58; border-radius: parent.height * 0.29; border-width: 8px; border-color: root.lighting-style == 0 ? #43c7c0 : root.lighting-style == 1 ? Theme.amber : #ce4cbd; background: #202024; }
                                Text { x: parent.width * 0.55; width: parent.width * 0.38; text: root.lighting-style == 0 ? "SOLID COLOUR" : root.lighting-style == 1 ? "PEAK METER" : "SOLID SPECTRUM"; color: Theme.text; font-size: 13px; font-weight: 800; vertical-alignment: center; }
                            }
                        }
                    }
                }
                Rectangle { height: 32px; background: #1b1b1e; Text { x: 10px; text: "BEACN STUDIO OTHER LIGHTING OPTIONS"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; } }
                Rectangle {
                    vertical-stretch: 1; background: #252528; border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        padding: 14px; spacing: 28px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 9px;
                            Text { height: 18px; text: "WHEN MUTED"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { height: 18px; text: "Choose the local preview shown for a muted microphone."; color: Theme.quiet; font-size: 9px; }
                            HorizontalLayout { height: 28px; spacing: 16px; Text { text: root.lighting-muted-mode == 0 ? "● Off" : "○ Off"; color: root.lighting-muted-mode == 0 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-muted-mode = 0; } } } Text { text: root.lighting-muted-mode == 1 ? "● Solid Colour" : "○ Solid Colour"; color: root.lighting-muted-mode == 1 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-muted-mode = 1; } } } Text { text: root.lighting-muted-mode == 2 ? "● Dim" : "○ Dim"; color: root.lighting-muted-mode == 2 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-muted-mode = 2; } } } }
                            HorizontalLayout { height: 34px; spacing: 8px; Rectangle { width: 28px; background: #e74d54; border-radius: 14px; } Rectangle { width: 28px; background: #43c7c0; border-radius: 14px; } Rectangle { width: 28px; background: #7f56d9; border-radius: 14px; } Rectangle { width: 28px; background: #f1b83b; border-radius: 14px; } }
                            Rectangle { vertical-stretch: 1; }
                        }
                        Rectangle { width: 1px; background: Theme.border; }
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 9px;
                            Text { height: 18px; text: "WHEN USB IS SUSPENDED"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { height: 18px; text: "Choose the local preview for a suspended host connection."; color: Theme.quiet; font-size: 9px; }
                            HorizontalLayout { height: 28px; spacing: 16px; Text { text: root.lighting-suspended-mode == 0 ? "● Off" : "○ Off"; color: root.lighting-suspended-mode == 0 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-suspended-mode = 0; } } } Text { text: root.lighting-suspended-mode == 1 ? "● Solid Colour" : "○ Solid Colour"; color: root.lighting-suspended-mode == 1 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-suspended-mode = 1; } } } Text { text: root.lighting-suspended-mode == 2 ? "● Dim" : "○ Dim"; color: root.lighting-suspended-mode == 2 ? Theme.teal : Theme.quiet; font-size: 10px; TouchArea { clicked => { root.lighting-suspended-mode = 2; } } } }
                            Text { text: "Preview controls only — StudioBridge never sends lighting writes."; color: Theme.amber; font-size: 9px; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }

            if root.active-page == 3: VerticalLayout {
                spacing: 0px;
                Rectangle { height: 42px; background: #1b1b1e; Text { x: 10px; text: "DEVICE SETTINGS"; color: Theme.text; font-size: 13px; font-weight: 800; vertical-alignment: center; } }
                Rectangle {
                    width: 755px;
                    height: 285px;
                    background: #1f1f22;
                    border-width: 1px; border-color: Theme.border;
                    Image { x: 68px; y: 28px; width: 70px; height: 70px; source: @image-url("../assets/studiobridge.svg"); }
                    Text { x: 158px; y: 42px; text: "Device Name:"; color: Theme.text; font-size: 13px; font-weight: 800; }
                    Text { x: 158px; y: 64px; text: root.device-name; color: Theme.quiet; font-size: 12px; font-weight: 700; }
                    Text { x: 110px; y: 124px; text: "Device Information"; color: Theme.text; font-size: 13px; font-weight: 800; }
                    Text { x: 110px; y: 150px; text: "Serial Number:"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                    Text { x: 285px; y: 150px; text: root.device-serial; color: Theme.text; font-size: 11px; font-weight: 700; }
                    Text { x: 110px; y: 169px; text: "Firmware Version:"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                    Text { x: 285px; y: 169px; text: root.device-firmware; color: Theme.text; font-size: 11px; font-weight: 700; }
                    Text { x: 110px; y: 242px; text: "USB2 Driverless Mode"; color: Theme.quiet; font-size: 11px; font-weight: 700; }
                    ToggleSwitch { x: 610px; y: 239px; checked: false; interactive: false; }
                    Text { x: 450px; y: 244px; text: "read-only"; color: Theme.amber; font-size: 9px; }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.active-page == 4: ScrollView {
                VerticalLayout {
                    x: 0px;
                    width: 684px;
                    padding-top: 34px;
                    padding-bottom: 34px;
                    padding-left: 44px;
                    padding-right: 34px;
                    spacing: 4px;
                    Text { text: "DEVICE POWER SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Boot StudioBridge on System Startup"; checked: root.start-at-login; toggled(value) => { root.start-at-login = value; root.save-preferences(value, root.close-to-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    SettingRow { label: "Open StudioBridge to System Tray"; checked: root.close-to-tray; toggled(value) => { root.close-to-tray = value; root.save-preferences(root.start-at-login, value, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE APP SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Show Save Confirmation Window"; checked: root.save-confirmation; toggled(value) => { root.save-confirmation = value; root.save-preferences(root.start-at-login, root.close-to-tray, value, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE BETA OPT-IN"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Opt-In to StudioBridge Public Beta Releases"; checked: root.beta-opt-in; toggled(value) => { root.beta-opt-in = value; root.save-preferences(root.start-at-login, root.close-to-tray, root.save-confirmation, value, root.mixing-suite-enabled, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "STUDIOBRIDGE MIXING SUITE"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "StudioBridge Mixing Suite Enabled"; checked: root.mixing-suite-enabled; toggled(value) => { root.mixing-suite-enabled = value; root.save-preferences(root.start-at-login, root.close-to-tray, root.save-confirmation, root.beta-opt-in, value, root.automatic-default-reset, root.meter-crossfade); } }
                    Text { text: "LINUX AUDIO SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Automatic Linux Default Device Reset"; checked: root.automatic-default-reset; toggled(value) => { root.automatic-default-reset = value; root.save-preferences(root.start-at-login, root.close-to-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, value, root.meter-crossfade); } }
                    Text { text: "MIXER SETTINGS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    SettingRow { label: "Enable Crossfade on Profile Switching"; checked: root.meter-crossfade; toggled(value) => { root.meter-crossfade = value; root.save-preferences(root.start-at-login, root.close-to-tray, root.save-confirmation, root.beta-opt-in, root.mixing-suite-enabled, root.automatic-default-reset, value); } }
                    Text { text: "HOTKEY ASSIGNMENTS"; color: Theme.text; font-size: 12px; font-weight: 800; }
                    for hotkey in root.hotkeys: VerticalLayout {
                        spacing: 1px;
                        if hotkey.section != "": Text { height: 18px; text: hotkey.section; color: Theme.text; font-size: 10px; font-weight: 800; }
                        Rectangle {
                            height: 26px;
                            Text { x: 12px; width: 330px; text: hotkey.label; color: Theme.quiet; font-size: 10px; vertical-alignment: center; overflow: elide; }
                            Text { x: 350px; width: 210px; text: hotkey.binding == "" ? "+" : hotkey.binding; color: hotkey.binding == "" ? Theme.quiet : Theme.text; font-size: hotkey.binding == "" ? 18px : 9px; horizontal-alignment: right; vertical-alignment: center; }
                            TouchArea { clicked => { root.hotkey-editor-action = hotkey.action; root.hotkey-editor-label = hotkey.label; root.hotkey-editor-input = hotkey.binding; root.hotkey-editor-open = true; } }
                        }
                    }
                    Rectangle { height: 16px; }
                    HorizontalLayout { Button { text: "Refresh status"; clicked => { root.refresh(); } } StatusPill { label: root.daemon-connected ? "DAEMON CONNECTED" : "DAEMON DISCONNECTED"; good: root.daemon-connected; } StatusPill { label: root.hardware-safe ? "HARDWARE WRITES OFF" : "WRITES ACTIVE"; good: root.hardware-safe; } Rectangle { horizontal-stretch: 1; } }
                }
            }

            Rectangle {
                height: 24px;
                background: #171719;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.status-text; color: root.daemon-connected ? Theme.quiet : Theme.red; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } Text { text: root.hardware-safe ? "HARDWARE WRITES OFF" : "WRITES ACTIVE"; color: root.hardware-safe ? Theme.green : Theme.red; font-size: 9px; font-weight: 800; vertical-alignment: center; } Text { text: "  ·  StudioBridge"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; } }
            }
        }

            ProfileRail {
                connected: root.daemon-connected;
                hardware-safe: root.hardware-safe;
                link-active: root.link-active;
                mixer-profiles: root.mixer-profiles;
                create-profile => { root.create-mixer-profile(); }
                save-profile(name) => { root.save-mixer-profile(name); }
                duplicate-profile(name) => { root.duplicate-mixer-profile(name); }
                select-profile(name) => { root.load-mixer-profile(name); }
                delete-profile(name) => { root.delete-mixer-profile(name); }
            }
        }
    }
    if root.hotkey-editor-open: Rectangle {
        z: 100;
        width: parent.width; height: parent.height; background: #00000099;
        Rectangle {
            x: (parent.width - 420px) / 2; y: (parent.height - 180px) / 2; width: 420px; height: 180px;
            background: #28282c; border-width: 1px; border-color: #505057; border-radius: 4px;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "HOTKEY ASSIGNMENT"; color: Theme.text; font-size: 13px; font-weight: 800; }
                Text { text: root.hotkey-editor-label; color: Theme.quiet; font-size: 11px; }
                Text { text: "Enter a shortcut such as Ctrl+Shift+F9. Wayland will confirm it through the desktop portal."; color: Theme.quiet; font-size: 9px; wrap: word-wrap; }
                LineEdit { text: root.hotkey-editor-input; edited(text) => { root.hotkey-editor-input = text; } }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "Save"; clicked => { root.save-hotkey(root.hotkey-editor-action, root.hotkey-editor-input); root.hotkey-editor-open = false; } }
                    Button { text: "Clear"; clicked => { root.save-hotkey(root.hotkey-editor-action, ""); root.hotkey-editor-open = false; } }
                    Button { text: "Cancel"; clicked => { root.hotkey-editor-open = false; } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

export component StudioBridgeTray inherits SystemTrayIcon {
    icon: @image-url("../assets/studiobridge.svg");
    title: "StudioBridge";
    tooltip: "StudioBridge · BEACN Studio control";
    callback show-app;
    callback show-safe-mode;
    callback quit-app;
    clicked => { root.show-app(); }
    Menu {
        MenuItem { title: "Open StudioBridge"; activated => { root.show-app(); } }
        MenuItem { title: "Open Microphone / Safe Mode"; activated => { root.show-safe-mode(); } }
        MenuSeparator { }
        MenuItem { title: "Quit StudioBridge"; activated => { root.quit-app(); } }
    }
}
