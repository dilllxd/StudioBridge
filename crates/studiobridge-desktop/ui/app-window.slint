import { Button, ComboBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";

export struct SourceModel {
    channel-id: string,
    meter-id: string,
    name: string,
    detail: string,
    colour: color,
    personal: float,
    audience: float,
    meter: float,
    linked: bool,
    personal-muted: bool,
    audience-muted: bool,
}

export struct RouteModel {
    source-id: string,
    source-name: string,
    target-id: string,
    target-name: string,
    target-mix: string,
    colour: color,
    enabled: bool,
    row: int,
    column: int,
}

export struct ApplicationModel {
    process: string,
    name: string,
    title: string,
    channel-index: int,
}

export struct LinkApplicationModel {
    name: string,
    channel-index: int,
}

export struct TargetModel {
    target-id: string,
    meter-id: string,
    name: string,
    mix: string,
    volume: float,
    meter: float,
    muted: bool,
}

global Theme {
    in property <color> background: #19191b;
    in property <color> panel: #222225;
    in property <color> raised: #29292d;
    in property <color> border: #37373b;
    in property <color> text: #f0eff1;
    in property <color> quiet: #9a999f;
    in property <color> teal: #42c9c6;
    in property <color> amber: #d6aa55;
    in property <color> green: #69d195;
    in property <color> red: #e4665e;
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <bool> good;
    height: 26px;
    min-width: 104px;
    border-radius: 13px;
    border-width: 1px;
    border-color: good ? #397b59 : #77463f;
    background: good ? #152e22 : #301c1a;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: good ? Theme.green : Theme.red; }
        Text { text: root.label; color: good ? #bae8ca : #efb0aa; font-size: 10px; font-weight: 700; }
    }
}

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 58px;
    border-radius: 29px;
    background: active ? Theme.teal : #202023;
    border-width: 1px;
    border-color: active ? #78e5df : #29292d;
    if root.label == "MIXER": HorizontalLayout {
        x: 14px; y: 12px; width: 30px; height: 34px; spacing: 5px;
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 7px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 19px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
        Rectangle { width: 4px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; Rectangle { x: -3px; y: 11px; width: 10px; height: 5px; background: root.active ? #ffffff : Theme.quiet; border-radius: 2px; } }
    }
    if root.label == "STUDIO": Rectangle {
        x: 13px; y: 17px; width: 32px; height: 24px; border-radius: 4px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 4px; y: -6px; width: 24px; height: 7px; border-radius: 3px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent; }
    }
    if root.label == "MIC": Rectangle {
        x: 14px; y: 10px; width: 30px; height: 30px; border-radius: 15px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 10px; y: 5px; width: 10px; height: 16px; border-radius: 5px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent; }
        Rectangle { x: 14px; y: 22px; width: 2px; height: 8px; background: root.active ? #ffffff : Theme.quiet; }
    }
    if root.label == "LIGHTING": Rectangle {
        x: 18px; y: 10px; width: 22px; height: 34px; border-radius: 4px; border-width: 2px; border-color: root.active ? #ffffff : Theme.quiet; background: transparent;
        Rectangle { x: 5px; y: 5px; width: 12px; height: 12px; border-radius: 6px; background: root.active ? #ffffff : Theme.quiet; }
        Rectangle { x: 5px; y: 23px; width: 12px; height: 3px; background: root.active ? #ffffff : Theme.quiet; }
    }
    if root.label == "DEVICE" || root.label == "SETTINGS": Text { text: "⚙"; color: root.active ? #ffffff : Theme.quiet; font-size: 27px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component LevelMeter inherits Rectangle {
    in property <float> value;
    in property <color> colour: Theme.teal;
    width: 9px;
    background: #070b0c;
    border-width: 1px;
    border-color: #354146;
    border-radius: 2px;
    Rectangle {
        x: 2px;
        width: parent.width - 4px;
        y: parent.height * (1.0 - root.value / 100.0);
        height: parent.height * root.value / 100.0;
        background: root.colour;
        border-radius: 1px;
        animate y { duration: 65ms; easing: ease-out; }
        animate height { duration: 65ms; easing: ease-out; }
    }
}

export struct ProfileModel {
    name: string,
    active: bool,
}

export struct HotkeyModel {
    section: string,
    label: string,
    action: string,
    binding: string,
}

component VerticalFader inherits Rectangle {
    in property <float> value;
    in property <color> accent: Theme.teal;
    in property <bool> muted;
    in property <bool> personal;
    in property <bool> show-mute: true;
    callback changed(float);
    callback mute-clicked;
    width: 34px;
    background: #171719;
    border-width: 1px;
    border-color: root.accent == Theme.teal ? Theme.teal : #111113;
    border-radius: 3px;
    Rectangle {
        x: (parent.width - 5px) / 2;
        y: 9px;
        width: 5px;
        height: parent.height - (root.show-mute ? 58px : 18px);
        background: #0d0d0f;
        border-radius: 2px;
    }
    Rectangle {
        x: 6px;
        y: 7px + (parent.height - (root.show-mute ? 64px : 24px)) * (1.0 - root.value / 100.0);
        width: parent.width - 12px;
        height: 7px;
        background: #e5e5e5;
        border-radius: 1px;
        animate y { duration: 55ms; easing: ease-out; }
    }
    Rectangle {
        visible: root.show-mute;
        x: 3px;
        y: parent.height - 42px;
        width: parent.width - 6px;
        height: 36px;
        background: root.muted ? #5d2528 : #202023;
        border-width: 1px;
        border-color: root.muted ? Theme.red : #34343a;
        border-radius: 4px;
        Text { text: root.personal ? "◉" : "((•))"; color: root.muted ? Theme.red : Theme.quiet; font-size: root.personal ? 19px : 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.mute-clicked(); } }
    }
    TouchArea {
        height: root.show-mute ? parent.height - 45px : parent.height;
        moved => {
            if (self.pressed) {
                root.changed(100.0 - self.mouse-y / self.height * 100.0);
            }
        }
        clicked => { root.changed(100.0 - self.mouse-y / self.height * 100.0); }
    }
}

component HorizontalFader inherits Rectangle {
    in property <float> value;
    callback changed(float);
    height: 20px;
    background: transparent;
    Rectangle { x: 0px; y: 8px; width: parent.width; height: 4px; background: #171719; border-radius: 2px; }
    Rectangle { x: 0px; y: 8px; width: parent.width * root.value / 100.0; height: 4px; background: Theme.teal; border-radius: 2px; }
    Rectangle {
        x: (parent.width - 10px) * root.value / 100.0;
        y: 3px;
        width: 10px;
        height: 14px;
        background: #dedee0;
        border-radius: 2px;
        animate x { duration: 55ms; easing: ease-out; }
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.changed(self.mouse-x / self.width * 100.0);
            }
        }
        clicked => { root.changed(self.mouse-x / self.width * 100.0); }
    }
}

component MixFader inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> meter;
    in property <bool> muted;
    in property <color> accent;
    callback changed(float);
    callback mute-clicked;
    background: transparent;
    VerticalLayout {
        spacing: 5px;
        Text { text: root.label; color: root.accent; font-size: 8px; font-weight: 800; horizontal-alignment: center; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Rectangle { horizontal-stretch: 1; }
            LevelMeter { value: root.muted ? 0 : root.meter; colour: root.accent; }
            VerticalFader {
                value: root.value;
                accent: root.accent;
                muted: root.muted;
                personal: root.label == "PERSONAL";
                changed(value) => { root.changed(value); }
                mute-clicked => { root.mute-clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component SourceStrip inherits Rectangle {
    in property <SourceModel> source;
    in-out property <bool> menu-open: false;
    callback personal-changed(float);
    callback audience-changed(float);
    callback personal-mute;
    callback audience-mute;
    callback link-changed(bool);
    callback delete-source;
    width: 133px;
    height: 398px;
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding: 7px;
        spacing: 5px;
        Rectangle {
            height: 22px;
            HorizontalLayout {
                spacing: 3px;
                Text { text: "⠿"; color: #5f5e64; font-size: 10px; vertical-alignment: center; }
                Text { text: root.source.name; color: Theme.text; font-size: 13px; font-weight: 800; horizontal-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: "v"; color: Theme.quiet; font-size: 9px; vertical-alignment: center; }
            }
            TouchArea { clicked => { root.menu-open = !root.menu-open; } }
        }
        Rectangle { height: 3px; background: root.source.colour; }
        HorizontalLayout {
            height: 215px;
            spacing: 3px;
            MixFader {
                label: "PERSONAL";
                value: root.source.personal;
                meter: root.source.meter;
                muted: root.source.personal-muted;
                accent: Theme.teal;
                changed(value) => { root.personal-changed(value); }
                mute-clicked => { root.personal-mute(); }
            }
            MixFader {
                label: "AUDIENCE";
                value: root.source.audience;
                meter: root.source.meter * root.source.audience / 100.0;
                muted: root.source.audience-muted;
                accent: Theme.amber;
                changed(value) => { root.audience-changed(value); }
                mute-clicked => { root.audience-mute(); }
            }
        }
        Rectangle {
            height: 18px;
            background: transparent;
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.source.linked ? Theme.teal : Theme.border;
                    background: root.source.linked ? #15302e : #101619;
                    Text { text: root.source.linked ? "∞" : "--"; color: root.source.linked ? Theme.teal : Theme.quiet; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.link-changed(!root.source.linked); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: 82px;
            background: #1a1a1d;
            border-width: 1px;
            border-color: #2d2d31;
            Text { x: 7px; y: 6px; width: parent.width - 14px; text: root.source.detail; color: Theme.quiet; font-size: 8px; overflow: elide; }
        }
        Rectangle {
            height: 20px;
            background: #202023;
            border-width: 1px;
            border-color: #303034;
            Text { text: "Mute to Audience    v"; color: Theme.quiet; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.audience-mute(); } }
        }
    }
    Rectangle {
        visible: root.menu-open;
        z: 20;
        x: 39px; y: 28px; width: 88px; height: 28px;
        background: #2d2d31; border-width: 1px; border-color: #4b4b50; border-radius: 2px;
        Text { text: "Delete Knob"; color: Theme.text; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.menu-open = false; root.delete-source(); } }
    }
}

component ContextTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: 126px;
    background: active ? #1b292d : transparent;
    Text { text: root.label; color: root.active ? Theme.teal : Theme.quiet; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.active ? Theme.teal : transparent; }
    TouchArea { clicked => { root.clicked(); } }
}

component TargetStrip inherits Rectangle {
    in property <TargetModel> target;
    callback volume-changed(float);
    // BEACN keeps the default Personal/Audience device cards compact instead
    // of stretching them across the entire mixer canvas.
    width: root.target.mix == "Personal" ? 396px : 398px;
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.raised;
    HorizontalLayout {
        padding: 7px;
        spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            Text { text: root.target.name; color: Theme.text; font-size: 12px; font-weight: 800; overflow: elide; }
            Text { text: root.target.mix + (root.target.muted ? " · MUTED" : " output"); color: root.target.muted ? Theme.red : Theme.quiet; font-size: 9px; }
            HorizontalFader { value: root.target.volume; changed(value) => { root.volume-changed(value); } }
        }
        LevelMeter { width: 12px; value: root.target.muted ? 0 : root.target.meter; colour: root.target.mix == "Personal" ? Theme.teal : Theme.amber; }
        Text { text: round(root.target.volume) + "%"; color: Theme.text; font-size: 10px; vertical-alignment: center; }
    }
}

component AssignmentRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 58px;
    border-radius: 3px;
    background: Theme.raised;
}

component Dial inherits Rectangle {
    in property <string> label;
    in property <string> value-label;
    in property <bool> active: true;
    width: 82px;
    height: 108px;
    background: transparent;
    Rectangle {
        x: 10px;
        y: 4px;
        width: 62px;
        height: 62px;
        border-radius: 31px;
        background: #171719;
        border-width: 5px;
        border-color: root.active ? Theme.teal : #4a494f;
        Rectangle { x: 27px; y: 3px; width: 4px; height: 16px; background: root.active ? Theme.teal : Theme.quiet; border-radius: 2px; }
    }
    Text { x: 0px; y: 72px; width: parent.width; text: root.label; color: Theme.text; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
    Text { x: 0px; y: 89px; width: parent.width; text: root.value-label; color: root.active ? Theme.teal : Theme.quiet; font-size: 9px; horizontal-alignment: center; }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> interactive: true;
    callback toggled(bool);
    width: 34px;
    height: 18px;
    border-radius: 9px;
    background: root.checked ? Theme.teal : #414147;
    Rectangle {
        x: root.checked ? parent.width - 16px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #dddddf;
        animate x { duration: 80ms; easing: ease-out; }
    }
    TouchArea { enabled: root.interactive; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 40px;
    background: transparent;
    border-width: 1px;
    border-color: #2f2f33;
    Text { x: 4px; width: parent.width - 58px; text: root.label; color: Theme.quiet; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    ToggleSwitch { x: parent.width - 42px; y: 11px; checked: root.checked; toggled(value) => { root.checked = value; root.toggled(value); } }
}

component ModuleTab inherits Rectangle {
    in property <string> label;
    in property <string> module;
    in property <string> selected;
    callback clicked(string);
    min-width: 126px;
    background: root.module == root.selected ? #1c2b2f : #111719;
    border-width: 1px;
    border-color: root.module == root.selected ? Theme.teal : Theme.border;
    Text { text: root.label; color: root.module == root.selected ? Theme.teal : Theme.quiet; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(root.module); } }
}

component MixerProfileRow inherits Rectangle {
    in property <ProfileModel> profile;
    callback selected;
    callback saved;
    callback duplicated;
    callback deleted;
    height: 24px;
    background: root.profile.active ? #3a393e : transparent;

    Text {
        x: 16px;
        width: parent.width - 78px;
        text: root.profile.name;
        color: root.profile.active ? Theme.text : Theme.quiet;
        font-size: 11px;
        font-weight: root.profile.active ? 700 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    name-area := TouchArea { width: parent.width - 58px; clicked => { root.selected(); } }

    save-text := Text { x: parent.width - 58px; width: 18px; text: "▣"; color: Theme.quiet; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; visible: name-area.has-hover || save-area.has-hover || duplicate-area.has-hover || delete-area.has-hover; }
    save-area := TouchArea { x: parent.width - 58px; width: 18px; clicked => { root.saved(); } }

    duplicate-text := Text { x: parent.width - 38px; width: 18px; text: "▱"; color: Theme.quiet; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; visible: name-area.has-hover || save-area.has-hover || duplicate-area.has-hover || delete-area.has-hover; }
    duplicate-area := TouchArea { x: parent.width - 38px; width: 18px; clicked => { root.duplicated(); } }

    delete-text := Text { x: parent.width - 18px; width: 18px; text: "×"; color: Theme.quiet; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; visible: name-area.has-hover || save-area.has-hover || duplicate-area.has-hover || delete-area.has-hover; }
    delete-area := TouchArea { x: parent.width - 18px; width: 18px; clicked => { root.deleted(); } }
}

component ProfileRail inherits Rectangle {
    in property <bool> connected;
    in property <bool> hardware-safe;
    in property <bool> link-active;
    in property <[ProfileModel]> mixer-profiles;
    callback create-profile;
    callback save-profile(string);
    callback duplicate-profile(string);
    callback select-profile(string);
    callback delete-profile(string);
    width: 285px;
    background: #242427;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding-top: 10px;
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 8px;

        Text { text: "PROFILES"; color: Theme.text; font-size: 14px; font-weight: 800; }
        Rectangle { height: 1px; background: Theme.border; }

        Rectangle {
            height: 102px;
            background: transparent;
            VerticalLayout {
                spacing: 3px;
                Text { text: "v  BEACN Studio 1                                      +"; color: Theme.text; font-size: 12px; font-weight: 800; }
                Text { text: "     Default Profile (1)"; color: Theme.quiet; font-size: 11px; }
                Text { text: "     Default Profile"; color: Theme.quiet; font-size: 11px; }
                Rectangle {
                    height: 24px;
                    background: #3a393e;
                    Text { text: "     On Device"; color: Theme.text; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                spacing: 3px;
                Rectangle {
                    height: 24px;
                    Text { text: "v  Mixer Profiles"; color: Theme.text; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                    Text { x: parent.width - 18px; text: "+"; color: Theme.text; font-size: 18px; vertical-alignment: center; }
                    TouchArea { x: parent.width - 32px; width: 32px; clicked => { root.create-profile(); } }
                }
                for profile in root.mixer-profiles: MixerProfileRow {
                    profile: profile;
                    selected => { root.select-profile(profile.name); }
                    saved => { root.save-profile(profile.name); }
                    duplicated => { root.duplicate-profile(profile.name); }
                    deleted => { root.delete-profile(profile.name); }
                }
                if root.mixer-profiles.length == 0: Text { text: "     New Profile"; color: Theme.quiet; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Text { text: "App V0.1.0"; color: Theme.quiet; font-size: 9px; horizontal-alignment: right; }
    }
}

component AddSourceRow inherits Rectangle {
    in property <string> label;
    callback selected(string);
    height: 24px;
    background: touch.has-hover ? #3a393e : #27272b;
    Text { x: 9px; text: root.label; color: Theme.text; font-size: 10px; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.selected(root.label); } }
}

export component MainWindow inherits Window {
    title: "StudioBridge";
    icon: @image-url("../assets/studiobridge.svg");
    // BEACN's measured outer default is 1404x810 on Windows. Native window
    // decoration adds 2px horizontally and 32px vertically to this client.
    preferred-width: 1402px;
    preferred-height: 778px;
    min-width: 1120px;
    min-height: 700px;
    background: Theme.background;

    in property <[SourceModel]> sources;
    in property <[RouteModel]> routes;
    in property <[ApplicationModel]> linux-applications;
    in property <[LinkApplicationModel]> link-applications;
    in property <[TargetModel]> targets;
    in property <[ProfileModel]> mixer-profiles;
    in property <[HotkeyModel]> hotkeys;
    in property <[string]> mixer-channel-names;
    in property <[string]> link-channel-names;
    in property <[string]> default-input-names;
    in property <[string]> default-input-ids;
    in property <[string]> default-output-names;
    in property <[string]> default-output-ids;
    in property <int> default-input-index: -1;
    in property <int> default-output-index: -1;
    in-out property <int> active-page: 0;
    in-out property <int> mixer-context-page: 0;
    in property <bool> daemon-connected: false;
    in property <bool> hardware-safe: true;
    in property <bool> link-active: false;
    in property <int> dsp-gate-count: 0;
    in-out property <string> dsp-selected-module: "noise_suppression";
    in property <string> dsp-active-module: "";
    in property <int> dsp-lease-seconds: 0;
    in-out property <bool> arm-confirm-pending: false;
    in-out property <bool> dsp-advanced: false;
    in-out property <bool> noise-snapshot: false;
    in property <string> dsp-editor-title: "HEADPHONE EQUALIZER";
    in property <string> dsp-label-a: "Bass dB";
    in property <string> dsp-label-b: "Mids dB";
    in property <string> dsp-label-c: "Treble dB";
    in-out property <float> dsp-value-a: 0;
    in-out property <float> dsp-value-b: 0;
    in-out property <float> dsp-value-c: 0;
    in property <float> dsp-min-a: -12;
    in property <float> dsp-max-a: 12;
    in property <float> dsp-min-b: -12;
    in property <float> dsp-max-b: 12;
    in property <float> dsp-min-c: -12;
    in property <float> dsp-max-c: 12;
    in property <string> status-text: "Connecting to StudioBridge daemon";
    in property <string> device-name: "BEACN Studio";
    in property <string> device-serial: "Unavailable";
    in property <string> device-firmware: "Unavailable";
    in-out property <float> lighting-speed: 0;
    in-out property <float> lighting-brightness: 100;
    in-out property <int> lighting-style: 2;
    in-out property <int> lighting-muted-mode: 0;
    in-out property <int> lighting-suspended-mode: 0;
    in-out property <bool> start-at-login: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> save-confirmation: true;
    in-out property <bool> beta-opt-in: false;
    in-out property <bool> mixing-suite-enabled: true;
    in-out property <bool> automatic-default-reset: true;
    in-out property <bool> meter-crossfade: true;
    in-out property <bool> add-source-menu-open: false;
    in-out property <bool> hotkey-editor-open: false;
    in-out property <string> hotkey-editor-action: "";
    in-out property <string> hotkey-editor-label: "";
    in-out property <string> hotkey-editor-input: "";

    callback refresh;
    callback set-volume(string, string, float);
    callback set-target-volume(string, float);
    callback set-default-input(string);
    callback set-default-output(string);
    callback set-source-mute(string, string, bool);
    callback set-volume-linked(string, bool);
    callback set-route(string, string, bool);
    callback create-source(string);
    callback remove-source(string);
    callback create-mixer-profile;
    callback save-mixer-profile(string);
    callback duplicate-mixer-profile(string);
    callback load-mixer-profile(string);
    callback delete-mixer-profile(string);
    callback save-hotkey(string, string);
    callback assign-linux-application(string, string, int);
    callback assign-link-application(string, int);
    callback select-dsp-module(string);
    callback load-dsp;
    callback arm-dsp;
    callback disarm-dsp;
    callback apply-dsp(float, float, float);
    callback revert-dsp;
    callback save-preferences(bool, bool, bool, bool, bool, bool, bool);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 28px;
            background: #202023;
            border-width: 1px;
            border-color: #2c2c30;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                Text { text: "◇  STUDIOBRIDGE"; color: Theme.text; font-size: 10px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: root.daemon-connected ? "CONNECTED" : "OFFLINE"; color: root.daemon-connected ? Theme.teal : Theme.red; font-size: 9px; font-weight: 800; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            Rectangle {
            width: 72px;
            background: #171719;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 7px;
                spacing: 5px;
                RailButton { glyph: "☷"; label: "MIXER"; active: root.active-page == 0; clicked => { root.active-page = 0; } }
                RailButton { glyph: "▣"; label: "STUDIO"; active: root.active-page >= 1 && root.active-page <= 3; clicked => { root.active-page = 1; } }
                if root.active-page >= 1 && root.active-page <= 3: RailButton { glyph: "◉"; label: "MIC"; active: root.active-page == 1; clicked => { root.active-page = 1; } }
                if root.active-page >= 1 && root.active-page <= 3: RailButton { glyph: "✦"; label: "LIGHTING"; active: root.active-page == 2; clicked => { root.active-page = 2; } }
                if root.active-page >= 1 && root.active-page <= 3: RailButton { glyph: "⚙"; label: "DEVICE"; active: root.active-page == 3; clicked => { root.active-page = 3; } }
                Rectangle { vertical-stretch: 1; }
                RailButton { glyph: "⚙"; label: "SETTINGS"; active: root.active-page == 4; clicked => { root.active-page = 4; } }
            }
        }

            VerticalLayout {
                spacing: 0px;

            if root.active-page == 0: VerticalLayout {
                padding: 8px;
                spacing: 5px;
                Rectangle {
                    height: 400px;
                    clip: true;
                    horizontal-stretch: 1;
                    background: transparent;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        HorizontalLayout {
                            spacing: 4px;
                            for source in root.sources: SourceStrip {
                                source: source;
                                personal-changed(value) => { root.set-volume(source.channel-id, "personal", value); }
                                audience-changed(value) => { root.set-volume(source.channel-id, "audience", value); }
                                personal-mute => { root.set-source-mute(source.channel-id, "personal", !source.personal-muted); }
                                audience-mute => { root.set-source-mute(source.channel-id, "audience", !source.audience-muted); }
                                link-changed(linked) => { root.set-volume-linked(source.channel-id, linked); }
                                delete-source => { root.remove-source(source.channel-id); }
                            }
                            Rectangle {
                                width: 133px; height: 398px; background: #19191c; border-width: 1px; border-color: Theme.border; border-radius: 2px;
                                Text { text: "+"; color: Theme.quiet; font-size: 42px; font-weight: 200; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.add-source-menu-open = !root.add-source-menu-open; } }
                                Rectangle {
                                    visible: root.add-source-menu-open; z: 30; x: 4px; y: 34px; width: 125px; height: 316px;
                                    background: #27272b; border-width: 1px; border-color: #4b4b50;
                                    VerticalLayout {
                                        padding: 3px; spacing: 0px;
                                        AddSourceRow { label: "Mic"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Game"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Music"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Chat"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Browser"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "System"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Aux 1"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Aux 2"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Hardware"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Link In"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Link 2 In"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Link 3 In"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                        AddSourceRow { label: "Link 4 In"; selected(name) => { root.add-source-menu-open = false; root.create-source(name); } }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 74px;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.panel;
                    clip: true;
                    HorizontalLayout {
                        spacing: 0px;
                        ScrollView {
                            // The native BEACN viewport ends after Personal and
                            // Audience. Extra StudioBridge buses remain reachable
                            // by scrolling this device region horizontally.
                            width: 812px;
                            height: parent.height;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 5px;
                                for target in root.targets: TargetStrip { target: target; volume-changed(value) => { root.set-target-volume(target.target-id, value); } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }

                Rectangle {
                    height: 34px;
                    background: #0f1517;
                    HorizontalLayout {
                        spacing: 0px;
                        ContextTab { label: "ASSIGNMENTS"; active: root.mixer-context-page == 0; clicked => { root.mixer-context-page = 0; } }
                        ContextTab { label: "ROUTING TABLE"; active: root.mixer-context-page == 1; clicked => { root.mixer-context-page = 1; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.mixer-context-page == 0: HorizontalLayout {
                    spacing: 3px;
                    vertical-stretch: 1;
                    Rectangle {
                        width: 250px;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 7px;
                            Text { text: "RECORDING DEVICES"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "DEFAULT"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            ComboBox { height: 30px; model: root.default-input-names; current-index: root.default-input-index; selected(value) => { if self.current-index >= 0 && self.current-index < root.default-input-ids.length { root.set-default-input(root.default-input-ids[self.current-index]); } } }
                            Text { text: "VOD / RECORDING"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            Rectangle { height: 28px; background: Theme.raised; Text { x: 7px; text: "VOD Track · configure in Routing Table"; color: Theme.text; font-size: 9px; vertical-alignment: center; } }
                            Text { text: "DEFAULT PLAYBACK DEVICE"; color: Theme.quiet; font-size: 8px; font-weight: 800; }
                            ComboBox { height: 30px; model: root.default-output-names; current-index: root.default-output-index; selected(value) => { if self.current-index >= 0 && self.current-index < root.default-output-ids.length { root.set-default-output(root.default-output-ids[self.current-index]); } } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        width: 250px;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 6px;
                            Text { text: "OUTGOING STUDIO LINK ASSIGNMENTS"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "Multiple Windows apps may share a Link channel"; color: Theme.quiet; font-size: 9px; }
                            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 6px; for app in root.link-applications: AssignmentRow { title: app.name; HorizontalLayout { padding-left: 10px; padding-right: 8px; Text { text: app.name; color: Theme.text; font-size: 12px; font-weight: 700; horizontal-stretch: 1; } ComboBox { width: 140px; model: root.link-channel-names; current-index: app.channel-index; selected(value) => { root.assign-link-application(app.name, self.current-index); } } } } } }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 9px; spacing: 6px;
                            Text { text: "APPLICATIONS"; color: Theme.text; font-size: 11px; font-weight: 800; }
                            Text { text: "Assign Linux applications to a mixer source"; color: Theme.quiet; font-size: 9px; }
                            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 6px; for app in root.linux-applications: AssignmentRow { title: app.title; HorizontalLayout { padding-left: 8px; padding-right: 6px; VerticalLayout { horizontal-stretch: 1; Text { text: app.title; color: Theme.text; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: app.process; color: Theme.quiet; font-size: 8px; overflow: elide; } } ComboBox { width: 94px; model: root.mixer-channel-names; current-index: app.channel-index; selected(value) => { root.assign-linux-application(app.process, app.name, self.current-index); } } } } } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                if root.mixer-context-page == 1: ScrollView {
                    vertical-stretch: 1;
                    GridLayout {
                        x: 170px;
                        spacing: 4px;
                        for route in root.routes: Rectangle {
                            row: route.row + 1;
                            col: route.column + 1;
                            width: 90px;
                            height: 36px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: route.enabled ? Theme.teal : #653b37;
                            background: route.enabled ? #153230 : #251a19;
                            Text { text: route.enabled ? "✓" : "⊘"; color: route.enabled ? Theme.teal : Theme.red; font-size: 17px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.set-route(route.source-id, route.target-id, !route.enabled); } }
                        }
                        for route in root.routes: Rectangle {
                            visible: route.row == 0;
                            row: 0; col: route.column + 1; width: 90px; height: 36px; background: Theme.raised;
                            Rectangle { y: parent.height - 4px; height: 4px; background: route.colour; }
                            Text { text: route.source-name; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                        for route in root.routes: Rectangle {
                            visible: route.column == 0;
                            row: route.row + 1; col: 0; width: 110px; height: 36px; background: Theme.raised;
                            VerticalLayout { padding-left: 10px; Text { text: route.target-name; color: Theme.text; font-size: 11px; font-weight: 800; } Text { text: route.target-mix; color: Theme.quiet; font-size: 9px; } }
                        }
                    }
                }
            }

            if root.active-page == 1: VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    height: 265px;
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Rectangle {
                        width: 869px;
                        border-width: 1px; border-color: Theme.border; background: #0d1214;
                        Rectangle { x: 0px; y: parent.height * 0.50; width: parent.width * 0.22; height: parent.height * 0.22; background: #421d20; opacity: 0.75; }
                        Rectangle { x: parent.width * 0.22; y: parent.height * 0.44; width: parent.width * 0.28; height: parent.height * 0.12; background: #173b3b; opacity: 0.55; }
                        Rectangle { x: parent.width * 0.50; y: parent.height * 0.48; width: parent.width * 0.25; height: parent.height * 0.13; background: #443917; opacity: 0.55; }
                        Rectangle { x: parent.width * 0.75; y: parent.height * 0.45; width: parent.width * 0.25; height: parent.height * 0.11; background: #43172b; opacity: 0.55; }
                        Rectangle { x: 0px; y: parent.height * 0.5; width: parent.width; height: 1px; background: #354045; }
                        Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #222c30; }
                        Rectangle { x: parent.width * 0.5; width: 1px; height: parent.height; background: #222c30; }
                        Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #222c30; }
                        Path {
                            width: parent.width;
                            height: parent.height;
                            commands: "M 0 230 C 70 155 120 125 210 120 C 310 113 370 160 455 155 C 560 149 620 117 710 119 C 800 121 850 115 920 113";
                            fill: transparent;
                            stroke: #efefed;
                            stroke-width: 2px;
                        }
                        Path {
                            width: parent.width;
                            height: parent.height;
                            commands: "M 0 242 C 55 237 95 247 145 236 C 205 226 260 250 320 239 C 390 226 450 251 520 238 C 600 228 690 248 770 237 C 835 232 875 244 920 238";
                            fill: transparent;
                            stroke: #65656a;
                            stroke-width: 1px;
                        }
                        Rectangle { x: parent.width * 0.12; y: parent.height * 0.63; width: 16px; height: 16px; border-radius: 8px; background: Theme.red; }
                        Rectangle { x: parent.width * 0.34; y: parent.height * 0.44; width: 16px; height: 16px; border-radius: 8px; background: Theme.teal; }
                        Rectangle { x: parent.width * 0.58; y: parent.height * 0.57; width: 16px; height: 16px; border-radius: 8px; background: Theme.amber; }
                        Rectangle { x: parent.width * 0.78; y: parent.height * 0.42; width: 16px; height: 16px; border-radius: 8px; background: #ef4c8c; }
                        Text { x: parent.width * 0.05; y: 10px; text: "30"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.18; y: 10px; text: "100"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.32; y: 10px; text: "250"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.45; y: 10px; text: "500"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.58; y: 10px; text: "1k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.70; y: 10px; text: "2k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.82; y: 10px; text: "5k"; color: #77777d; font-size: 9px; }
                        Text { x: parent.width * 0.92; y: 10px; text: "16k"; color: #77777d; font-size: 9px; }
                    }
                    Rectangle {
                        width: 150px;
                        border-width: 1px; border-color: Theme.border; background: Theme.panel;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "MIC OUTPUT"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout {
                                vertical-stretch: 1;
                                Rectangle { horizontal-stretch: 1; }
                                LevelMeter { width: 24px; value: 36; colour: Theme.teal; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: "−18 dB"; color: Theme.teal; font-size: 18px; font-weight: 800; horizontal-alignment: center; }
                        }
                    }
                }

                HorizontalLayout {
                    height: 150px;
                    spacing: 4px;
                    Rectangle {
                        width: 420px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "equalizer" ? Theme.teal : Theme.border;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                width: 150px;
                                spacing: 5px;
                                Text { text: "ADD BAND"; color: Theme.red; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                                Text { text: "Presets"; color: Theme.quiet; font-size: 9px; }
                                Rectangle { height: 24px; background: #1a1a1d; Text { x: 6px; text: "Low Broadcast Voice      v"; color: Theme.text; font-size: 9px; vertical-alignment: center; } }
                                HorizontalLayout { height: 22px; Text { text: "Advanced EQ"; color: Theme.quiet; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } ToggleSwitch { checked: true; } }
                                HorizontalLayout { height: 22px; Text { text: "Guide"; color: Theme.quiet; font-size: 9px; horizontal-stretch: 1; vertical-alignment: center; } ToggleSwitch { checked: false; } }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 5px;
                                HorizontalLayout {
                                    height: 58px;
                                    spacing: 4px;
                                    Rectangle { width: 42px; background: #18181b; border-radius: 4px; Text { text: "⌒"; color: Theme.text; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 42px; background: #18181b; border-radius: 4px; Text { text: "∿"; color: Theme.text; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 42px; background: #18181b; border-radius: 4px; Text { text: "⌁"; color: Theme.text; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 42px; background: Theme.teal; border-radius: 4px; Text { text: "∿"; color: Theme.text; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                                Text { text: "FREQ    ◀   40Hz    ▶"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Text { text: "GAIN    ◀   -2.0dB  ▶"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Text { text: "Q       ◀   0.8     ▶"; color: Theme.text; font-size: 10px; font-weight: 700; }
                            }
                        }
                        TouchArea { clicked => { root.select-dsp-module("equalizer"); } }
                    }
                    Rectangle {
                        width: 202px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "enhancement_suite" ? Theme.teal : Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            Text { text: "BASS ENHANCE"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout { height: 34px; spacing: 5px; Rectangle { width: 34px; background: Theme.teal; Text { text: "1"; color: Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } } Rectangle { width: 34px; background: #18181b; Text { text: "2"; color: Theme.quiet; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } } Rectangle { width: 34px; background: #18181b; Text { text: "3"; color: Theme.quiet; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } } Rectangle { width: 34px; background: #18181b; Text { text: "4"; color: Theme.quiet; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } } }
                            HorizontalLayout { Dial { label: "DE-ESSER"; value-label: ""; } Dial { label: "AMOUNT"; value-label: ""; } }
                        }
                        TouchArea { clicked => { root.select-dsp-module("enhancement_suite"); } }
                    }
                    Rectangle {
                        width: 202px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: root.dsp-selected-module == "enhancement_suite" ? Theme.teal : Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            Text { text: "EXCITER"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout { Dial { label: "AMOUNT"; value-label: ""; } Dial { label: "FREQUENCY"; value-label: "4000Hz"; } }
                        }
                        TouchArea { clicked => { root.select-dsp-module("enhancement_suite"); } }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        spacing: 2px;
                        ModuleTab { label: "MIC SETUP"; module: "mic_setup"; selected: root.dsp-selected-module; clicked(module) => { root.dsp-selected-module = module; } }
                        ModuleTab { label: "NOISE SUPPRESSION"; module: "noise_suppression"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleTab { label: "EXPANDER"; module: "expander"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleTab { label: "COMPRESSOR"; module: "compressor"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        ModuleTab { label: "HEADPHONES"; module: "headphone_equalizer"; selected: root.dsp-selected-module; clicked(module) => { root.select-dsp-module(module); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if root.dsp-selected-module == "mic_setup": Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px; border-color: Theme.border; background: Theme.panel;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 16px;
                        VerticalLayout {
                            width: 96px;
                            Text { text: "Mic Gain"; color: Theme.text; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                            HorizontalLayout { vertical-stretch: 1; Rectangle { horizontal-stretch: 1; } VerticalFader { width: 38px; value: 59; accent: Theme.teal; muted: false; personal: true; show-mute: false; } Rectangle { horizontal-stretch: 1; } }
                            Text { text: "41dB"; color: Theme.teal; font-size: 11px; font-weight: 800; horizontal-alignment: center; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #19191c;
                            border-width: 1px; border-color: Theme.border;
                            Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height * 0.20; background: #8e7118; opacity: 0.75; }
                            Rectangle { x: 0px; y: parent.height * 0.20; width: parent.width; height: parent.height * 0.40; background: #237d79; opacity: 0.72; }
