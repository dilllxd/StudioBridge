                        padding: 10px; spacing: 6px;
                        HorizontalLayout {
                            Text { text: root.dsp-editor-title; color: Theme.text; font-size: 15px; font-weight: 800; horizontal-stretch: 1; }
                            StatusPill { label: root.dsp-active-module == root.dsp-selected-module ? "EDITING " + root.dsp-lease-seconds + "s" : "READ ONLY"; good: root.dsp-active-module == root.dsp-selected-module; }
                        }

