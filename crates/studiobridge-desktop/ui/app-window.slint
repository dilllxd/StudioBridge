component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> interactive: true;
    in property <string> control-label: "Toggle";
    callback toggled(bool);
    width: 34px;
    height: 18px;
    border-radius: 9px;
    background: root.checked ? Theme.teal : #414147;
    Rectangle {
        x: root.checked ? parent.width - 16px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #dddddf;
        animate x { duration: 80ms; easing: ease-out; }
    }
    toggle-focus := FocusScope {
        width: parent.width; height: parent.height;
        accessible-role: checkbox;
        accessible-checked: root.checked;
        accessible-label: root.control-label;
        key-pressed(event) => {
            if root.interactive && (event.text == Key.Return || event.text == Key.Space) {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
        TouchArea { enabled: root.interactive; clicked => { toggle-focus.focus(); root.checked = !root.checked; root.toggled(root.checked); } }
    }
}

