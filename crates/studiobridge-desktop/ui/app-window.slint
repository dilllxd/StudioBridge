                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                Text { text: root.dsp-label-b.to-uppercase() + "   " + round(root.dsp-value-b * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                                Text { text: root.dsp-label-c.to-uppercase() + "   " + round(root.dsp-value-c * 10) / 10 + " dB"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; changed(value) => { root.dsp-value-c = value; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1; background: #111518; border-width: 1px; border-color: Theme.border;
                                Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: #242a2d; }
                                Rectangle { y: parent.height * 0.50; width: parent.width; height: 1px; background: #343a3d; }
                                Path { width: parent.width; height: parent.height; commands: "M 0 94 C 120 94 150 48 245 54 C 340 60 370 118 470 105 C 570 92 625 58 720 62 C 800 66 850 70 900 70"; fill: transparent; stroke: Theme.teal; stroke-width: 2px; }
                                Text { x: 8px; y: 8px; text: "Guarded read-back voice EQ"; color: Theme.quiet; font-size: 9px; }
                            }
                        }

                        if root.dsp-selected-module == "enhancement_suite": HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                width: 330px; spacing: 7px;
                                Text { text: root.dsp-label-a.to-uppercase() + "   " + round(root.dsp-value-a * 10) / 10; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-a; minimum: root.dsp-min-a; maximum: root.dsp-max-a; changed(value) => { root.dsp-value-a = value; } }
                                Text { text: root.dsp-label-b.to-uppercase() + "   " + round(root.dsp-value-b * 10) / 10 + "%"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-b; minimum: root.dsp-min-b; maximum: root.dsp-max-b; changed(value) => { root.dsp-value-b = value; } }
                                Text { text: root.dsp-label-c.to-uppercase() + "   " + round(root.dsp-value-c * 10) / 10 + "%"; color: Theme.text; font-size: 10px; font-weight: 700; }
                                Slider { enabled: root.dsp-active-module == root.dsp-selected-module; value: root.dsp-value-c; minimum: root.dsp-min-c; maximum: root.dsp-max-c; changed(value) => { root.dsp-value-c = value; } }
                            }
                            HorizontalLayout {
