                root.changed(root.value + root.step > root.maximum ? root.maximum : root.value + root.step);
                return accept;
            }
            if root.interactive && (event.text == Key.DownArrow || event.text == Key.LeftArrow) {
                root.changed(root.value - root.step < root.minimum ? root.minimum : root.value - root.step);
                return accept;
            }
            return reject;
        }
        TouchArea {
            enabled: root.interactive;
            moved => {
                if (self.pressed) {
                    let candidate = root.maximum - self.mouse-y / self.height * (root.maximum - root.minimum);
                    root.changed(candidate < root.minimum ? root.minimum : candidate > root.maximum ? root.maximum : candidate);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    dial-focus.focus();
                }
            }
        }
    }
}

