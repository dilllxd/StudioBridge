[Unit]
Description=StudioBridge BEACN Studio control service
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/studiobridge
ExecStart=%h/.local/bin/studiobridge-daemon --studio beacn --mixer pipeweaver
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
